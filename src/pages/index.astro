---
import Base from '../layouts/Base.astro';
import Replay from '../components/Replay.astro';
import Kite from '../components/Kite.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import Download from '../components/Download.astro';
import Terminal from '../components/Terminal.astro';
import { REPO, BLOB, ONE_LINER, VERSION_FALLBACK } from '../data/site.js';

const families = [
  {
    key: 'o', name: 'OpenAI', client: 'Codex, through its app-server client',
    plan: 'As of 31 October 2026, OpenAI says its coding client is included in its Free, Go, Plus, Pro, Business, Edu and Enterprise plans. Usage limits depend on the plan, the model and the task.',
  },
  {
    key: 'a', name: 'Anthropic', client: 'Claude Code, through its stream-json mode',
    plan: 'As of 31 October 2026, Anthropic includes its coding client in its Pro, Max, Team and Enterprise plans and leaves it out of Free. Pro and Max have a five-hour limit and a weekly limit that the Anthropic chat app shares.',
  },
  {
    key: 'g', name: 'Google', client: 'Antigravity, through the Agent Client Protocol',
    plan: 'As of 31 October 2026, Google gives accounts without a paid plan a quota that refreshes weekly. Google AI Pro refreshes every five hours until a weekly limit, and Google AI Ultra has the highest quota. Limits follow available capacity.',
    terms: true,
  },
  {
    key: 'l', name: 'Local', client: 'LM Studio, on this computer',
    plan: 'As of 31 October 2026, LM Studio is free to use at home and at work. Speed and context follow your hardware.',
  },
];

const faqs = [
  {
    q: 'What is CrewKite?',
    a: `<p>A desktop workspace for coding with the agents you already pay for. It runs the OpenAI, Anthropic and Google clients you have signed in, plus a local model through LM Studio, as threads on your own computer. A thread can move to another provider mid task and keep its messages and edited files.</p>`,
  },
  {
    q: 'Which plans work?',
    a: `<p>CrewKite adds no plan gate. Each family works on whatever plan its provider allows, and the provider's limits apply. CrewKite sets no API key and never falls back to paid API billing. The provider section above has the dated line for each family, and <a href="${BLOB}/docs/providers.md#plans-per-family">Provider routes</a> has the longer notes.</p>`,
  },
  {
    q: 'Is my code sent anywhere?',
    a: `<p>Only where your provider's own client sends it when you run a turn on that provider. CrewKite has no telemetry, no account and no server of its own, and nothing is hosted. A Local thread stays on your computer. Models work in a scratch copy, and your checkout changes only when you accept a branch.</p>`,
  },
  {
    q: 'Is this a wrapper?',
    a: `<p>CrewKite runs each vendor's own client on purpose, so your sign-in, your plan and the vendor's terms stay yours. What it adds is one thread that passes work between providers, plan slices that run side by side, one controller that holds every permission, a scratch copy for each thread and a branch you review before anything touches your code.</p>`,
  },
  {
    q: 'Will my provider ban my account?',
    a: `<p>OpenAI, Anthropic and Local run through their own clients on their supported paths. Google is different. Google's third-party access FAQ says that third-party access through its coding client login violates its terms. Google does not name CrewKite, and CrewKite has no exception from Google. Using the Google route is your own choice and your own risk, and the app keeps it off until you tick a box that says so. <a href="${BLOB}/docs/providers.md#google-and-your-account">Read the full text</a>.</p>`,
  },
  {
    q: 'Does it run on Linux or Windows?',
    a: `<p>The Linux preview runs on x64 and arm64 with OpenAI, Anthropic and Local. Google is not on Linux yet. Windows is not supported yet. WSL2 is untested, so I cannot say whether the Linux preview runs there.</p>`,
  },
  {
    q: 'How does a handoff work?',
    a: `<p>Pick a model from another provider and send, or let the thread move by itself when a provider reaches its limit. The new provider starts from your messages, the earlier answers, the list of changed files and the patches that still fit, in the same scratch copy. When you return to a provider, it resumes its own session and gets the turns it missed. <a href="${BLOB}/docs/continuity.md">Continuity and recovery</a> has the details.</p>`,
  },
  {
    q: 'How do I uninstall it?',
    a: `<p>Quit the app, then remove the app, its data folder and its desktop profile. Thread refs in your repositories go with Delete in each thread's menu or one git command. <a href="${BLOB}/docs/preview.md#uninstall">The uninstall steps</a> list every location.</p>`,
  },
  {
    q: 'What license is it under?',
    a: `<p>The Apache License 2.0. The source, the docs and the architecture decision records are on <a href="${REPO}">GitHub</a>.</p>`,
  },
];
---
<Base title="CrewKite: your coding agents, one thread" path="/">
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <a class="pill reveal" href="/changelog">
        <span class="pill-tag">Prerelease</span>
        <span>Version <span data-release="version">{VERSION_FALLBACK}</span></span>
        <Icon name="arrow" size={14} />
      </a>
      <h1 id="hero-h" class="reveal">Your coding agents,<br /><span class="grad">one thread.</span></h1>
      <p class="hero-sub reveal">{ONE_LINER}</p>
      <div class="hero-cta reveal">
        <Download variant="hero" />
        <a class="btn btn-ghost" href={REPO}>
          <Icon name="code" />View on GitHub<span class="count" data-stars hidden></span>
        </a>
      </div>
      <p class="hero-meta reveal">
        <span class="mono">v<span data-release="version">{VERSION_FALLBACK}</span></span>
        <span data-release="date-line" hidden></span>
        <span>macOS 14+ on Apple silicon</span>
        <a href="/download#verify">SHA-256 checksums</a>
      </p>
      <div class="hero-shot">
        <Replay />
      </div>
    </div>
  </section>

  <!-- Providers -->
  <section id="providers" aria-labelledby="fam-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Providers</span>
        <h2 id="fam-h" class="h2">Run the clients you already sign in to</h2>
        <p class="lede">CrewKite starts each provider's own client with your sign-in and your plan. Model and effort lists come live from each client, so a new model shows up the day the provider serves it.</p>
      </div>
      <div class="fams">
        {families.map((f, i) => (
          <article class={`fcard fcard-${f.key} reveal`} style={`--d:${i * 70}ms`}>
            <div class="fcard-top">
              <span class={`fam fam-${f.key}`}>{f.key.toUpperCase()}</span>
              <h3>{f.name}</h3>
            </div>
            <p class="fcard-client">{f.client}</p>
            <p class="fcard-plan">{f.plan}</p>
            {f.terms && (
              <p class="fcard-terms">
                Google's terms say third-party access through its coding client login violates them. Using this route is your own choice and risk.{' '}
                <a href={`${BLOB}/docs/providers.md#google-and-your-account`}>Read the full text</a>
              </p>
            )}
          </article>
        ))}
      </div>
      <p class="fams-note reveal">CrewKite has no plan gate. Each provider decides what its free plan includes.</p>
    </div>
  </section>

  <!-- What it adds -->
  <section id="adds" aria-labelledby="adds-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">What it adds</span>
        <h2 id="adds-h" class="h2">What none of the clients does alone</h2>
        <p class="lede">CrewKite runs each vendor's own client on purpose, so your sign-in, your plan and the vendor's terms stay yours. These are the parts it adds on top.</p>
      </div>

      <div class="feat reveal">
        <div class="feat-copy">
          <span class="feat-n mono">01</span>
          <h3>Hand a thread to another provider</h3>
          <p>When a provider hits its limit, or you pick another one, the next turn continues there with the messages, the changed files and the patches that fit. Automatic handoff picks the provider with the most allowance left or the one that resets soonest.</p>
        </div>
        <div class="feat-vis vis-hand" aria-hidden="true">
          <div class="hand-gauges">
            <div class="hg" style="--c:var(--openai);--v0:42;--v1:0"><span class="fam fam-o">O</span><div class="hg-bar"><i></i></div><span class="hg-v mono"></span></div>
            <div class="hg" style="--c:var(--anthropic);--v0:74;--v1:68"><span class="fam fam-a">A</span><div class="hg-bar"><i></i></div><span class="hg-v mono"></span></div>
            <div class="hg" style="--c:var(--google);--v0:55;--v1:55"><span class="fam fam-g">G</span><div class="hg-bar"><i></i></div><span class="hg-v mono"></span></div>
            <div class="hg" style="--c:var(--local);--v0:100;--v1:100"><span class="fam fam-l">L</span><div class="hg-bar"><i></i></div><span class="hg-v mono"></span></div>
          </div>
          <div class="hand-line"><span>Continued on Anthropic from OpenAI. Reason: five-hour limit reached.</span></div>
          <div class="hand-turns">
            <div class="ht ht-o"><span class="fam fam-o">O</span><b></b><b></b></div>
            <div class="ht ht-a"><span class="fam fam-a">A</span><b></b><b></b><b></b></div>
          </div>
        </div>
      </div>

      <div class="feat feat-rev reveal">
        <div class="feat-copy">
          <span class="feat-n mono">02</span>
          <h3>Split a large request into slices</h3>
          <p>In the Full crew preset an orchestrator proposes a plan of up to 8 slices. The controller checks it, assigns each slice by allowance and difficulty, and runs independent slices side by side, each in its own copy. Subagents a provider starts show live in the thread.</p>
        </div>
        <div class="feat-vis vis-plan" aria-hidden="true">
          <div class="plan-h"><Kite size={14} /><span>Plan</span><span class="mono plan-c">4 slices</span></div>
          <div class="slice" style="--i:0"><span class="s-t">Map the rounding paths</span><span class="s-d">Easy</span><span class="fam fam-l">L</span><span class="s-s"><em>Done</em></span></div>
          <div class="slice" style="--i:1"><span class="s-t">Clamp netMinor at zero</span><span class="s-d">Medium</span><span class="fam fam-a">A</span><span class="s-s"><em>Done</em></span></div>
          <div class="slice" style="--i:2"><span class="s-t">Fix the tax rounding</span><span class="s-d">Hard</span><span class="fam fam-o">O</span><span class="s-s"><em>Done</em></span></div>
          <div class="slice" style="--i:3"><span class="s-t">Add tests for the edges</span><span class="s-d">Easy</span><span class="fam fam-g">G</span><span class="s-s"><em>Done</em></span></div>
          <div class="plan-f mono">Crew finished: 4 slices, 4 reviews, 1 fix.</div>
        </div>
      </div>

      <div class="feat reveal">
        <div class="feat-copy">
          <span class="feat-n mono">03</span>
          <h3>Keep every permission in one controller</h3>
          <p>Prompts and model output cannot grant permissions, raise limits or accept results. An edit or a command waits in the thread with its exact target, and you choose Allow once, Allow for this thread or Deny. The default is to ask every time.</p>
        </div>
        <div class="feat-vis vis-perm" aria-hidden="true">
          <div class="pc">
            <div class="pc-q"><Icon name="shield" size={16} />Edit src/tax.mjs in the scratch copy?</div>
            <div class="pc-cmd mono">+ return Math.round(amountMinor * rate)</div>
            <div class="pc-a"><span class="pb pb-1">Allow once</span><span class="pb">Allow for this thread</span><span class="pb pb-deny">Deny</span></div>
          </div>
          <div class="pc-lock"><Icon name="lock" size={14} />Policy: Ask each time</div>
        </div>
      </div>

      <div class="feat feat-rev reveal">
        <div class="feat-copy">
          <span class="feat-n mono">04</span>
          <h3>Review the work before it touches your code</h3>
          <p>Each thread works in a scratch copy of your repository. Changes shows every file against the base commit. Accept or discard single hunks, comment on lines, then accept to a new local branch. Push and the pull request wait for your click.</p>
        </div>
        <div class="feat-vis vis-changes" aria-hidden="true">
          <div class="ch-h"><span>Changes</span><span class="mono">3 files</span></div>
          <div class="ch-f"><span class="mono">src/net.mjs</span><span class="mono"><b class="plus">+5</b> <b class="minus">-2</b></span><span class="ch-k ch-k1">Accepted</span></div>
          <div class="ch-f"><span class="mono">src/tax.mjs</span><span class="mono"><b class="plus">+3</b> <b class="minus">-1</b></span><span class="ch-k ch-k2">Accepted</span></div>
          <div class="ch-f"><span class="mono">test/net.test.mjs</span><span class="mono"><b class="plus">+18</b></span><span class="ch-k ch-k3">Accepted</span></div>
          <div class="ch-b"><span class="mono"><Icon name="branch" size={14} />fix-rounding</span><span class="ch-btn">Accept to branch</span></div>
        </div>
      </div>

      <div class="feat reveal">
        <div class="feat-copy">
          <span class="feat-n mono">05</span>
          <h3>Find anything across threads</h3>
          <p>Project notes reach every model in the project. History search covers every thread, and the command palette reaches every action from the keyboard.</p>
          <ul class="chips">
            <li>Usage analytics with CSV</li>
            <li>Share page</li>
            <li>Markdown export</li>
            <li>Diagnostics export</li>
            <li>No file count cap</li>
          </ul>
        </div>
        <div class="feat-vis vis-pal" aria-hidden="true">
          <div class="pal">
            <div class="pal-in"><span class="pal-q">rounding</span><span class="mono pal-k">⌘K</span></div>
            <div class="pal-g">Threads</div>
            <div class="pal-r pal-on"><span class="fam fam-a">A</span>Fix rounding in tax totals<span class="pal-m">2 h ago</span></div>
            <div class="pal-r"><span class="fam fam-o">O</span>Clamp discount at subtotal<span class="pal-m">yesterday</span></div>
            <div class="pal-g">Actions</div>
            <div class="pal-r"><Icon name="arrow" size={14} />Continue on another provider</div>
            <div class="pal-r"><Icon name="branch" size={14} />Open Changes</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Safety -->
  <section id="safety" aria-labelledby="safe-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Safety</span>
        <h2 id="safe-h" class="h2">Safe with your repository and your accounts</h2>
      </div>
      <div class="safe">
        <article class="scard reveal"><Icon name="branch" size={22} /><h3>Your checkout is never written</h3><p>Models work in a scratch copy. Results land as new local branches, and only when you accept them.</p></article>
        <article class="scard reveal" style="--d:70ms"><Icon name="eye" size={22} /><h3>Nothing leaves your machine except what your provider client sends</h3><p>No telemetry, no account, no server of its own.</p></article>
        <article class="scard reveal" style="--d:140ms"><Icon name="key" size={22} /><h3>Secrets are redacted</h3><p>Tool output, exports and diagnostics go through redaction before they are shown or saved.</p></article>
        <article class="scard reveal" style="--d:210ms"><Icon name="lock" size={22} /><h3>Each vendor's own client runs with your own sign-in</h3><p>CrewKite never reads or stores a provider credential and never falls back to paid API billing.</p></article>
      </div>
      <p class="reveal more"><a class="arrow-link" href="/safety">How CrewKite handles authority <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- Terminal -->
  <section id="terminal" aria-labelledby="term-h">
    <div class="wrap term-grid">
      <div class="reveal">
        <span class="eyebrow">Terminal too</span>
        <h2 id="term-h" class="h2">The same threads in your terminal</h2>
        <p class="lede">The CLI talks to the same controller as the desktop. Start a thread in one and pick it up in the other. Slash commands, file mentions and <code>crewkite -p</code> for scripts.</p>
        <div class="cmd term-cmd"><code>pnpm crewkite</code><button class="copy" type="button" data-copy="pnpm crewkite" hidden><Icon name="copy" size={13} />Copy</button></div>
        <p class="small">From a source checkout. <a href={`${BLOB}/apps/cli/README.md`}>The CLI guide</a> lists every key and command.</p>
      </div>
      <div class="reveal">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section id="open" aria-labelledby="open-h">
    <div class="wrap">
      <div class="os reveal">
        <div class="os-copy">
          <span class="eyebrow">Open source</span>
          <h2 id="open-h" class="h2">Apache 2.0, built in the open</h2>
          <p class="lede">Prerelease. I build CrewKite in the open and ship it as it gets better. Every decision has an architecture decision record, and an extension seam lets separately licensed modules plug in.</p>
          <div class="os-links">
            <a class="arrow-link" href={REPO}>Source <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/CONTRIBUTING.md`}>Contributing <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/docs/adr/README.md`}>Decision records <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/docs/extensions.md`}>Extension seam <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <dl class="os-stats">
          <div><dt>License</dt><dd>Apache 2.0</dd></div>
          <div><dt>Version</dt><dd class="mono" data-release="version">{VERSION_FALLBACK}</dd></div>
          <div data-stars-row hidden><dt>GitHub stars</dt><dd class="mono" data-stars-plain></dd></div>
          <div><dt>Telemetry</dt><dd>None</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div class="reveal">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-h" class="h2">Questions</h2>
        <p class="lede">The rest is in the <a href="/docs">docs</a>.</p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="reveal">
            <summary><span>{f.q}</span><Icon name="plus" size={18} /></summary>
            <div class="faq-a" set:html={f.a} />
          </details>
        ))}
        <details class="reveal">
          <summary><span>How do I reach you?</span><Icon name="plus" size={18} /></summary>
          <div class="faq-a">
            <p>Email me at <Email />. Open an issue on <a href={`${REPO}/issues`}>GitHub</a> for bugs and requests. Report a security issue privately through GitHub as <a href={`${BLOB}/SECURITY.md`}>SECURITY.md</a> describes, never by email or in a public issue.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final call -->
  <section class="final" aria-labelledby="final-h">
    <div class="wrap">
      <div class="final-box reveal">
        <Kite size={56} class="final-kite" />
        <h2 id="final-h" class="h2">Download CrewKite <span data-release="version">{VERSION_FALLBACK}</span></h2>
        <p class="lede">macOS 14 or later on Apple silicon. Linux x64 and arm64 preview. Windows is not supported yet.</p>
        <div class="hero-cta">
          <Download variant="final" />
          <a class="btn btn-ghost" href={REPO}><Icon name="code" />View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: 72px 0 40px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -10% 0 auto;
    height: 900px;
    background:
      radial-gradient(ellipse 50% 40% at 50% 30%, var(--glow), transparent 70%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 25%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 25%, #000 20%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color 160ms;
  }
  .pill:hover { border-color: var(--accent); color: var(--text); }
  .pill-tag {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    font-size: 12px;
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(36px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 650;
  }
  .grad {
    background: linear-gradient(100deg, var(--openai) 5%, var(--accent) 35%, var(--local) 60%, var(--anthropic) 95%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 9s var(--ease) infinite alternate;
  }
  @keyframes sheen {
    to { background-position: 100% 0; }
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 64ch;
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--text-muted);
  }
  .hero-cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .hero-meta {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    font-size: 13px;
    color: var(--text-dim);
  }
  .hero-meta a { color: var(--text-muted); text-underline-offset: 3px; }
  .hero-shot {
    margin-top: 64px;
    width: 100%;
    max-width: 1080px;
    perspective: 1600px;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-shot :global(.replay) {
        animation: tilt linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
        transform-origin: 50% 0;
      }
      @keyframes tilt {
        from { transform: rotateX(16deg) scale(0.94); opacity: 0.6; }
        to { transform: none; opacity: 1; }
      }
    }
  }
  .js .hero .reveal { transition-delay: calc(var(--i, 0) * 60ms); }

  /* Providers */
  .fams {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .fcard {
    position: relative;
    padding: 22px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
    transition-delay: var(--d, 0ms);
    transition-property: opacity, transform, border-color;
  }
  .fcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--c);
  }
  .fcard::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px 160px at 50% -40px, color-mix(in srgb, var(--c) 16%, transparent), transparent);
    opacity: 0;
    transition: opacity 300ms;
    pointer-events: none;
  }
  .fcard:hover { border-color: color-mix(in srgb, var(--c) 50%, var(--border)); }
  .fcard:hover::after { opacity: 1; }
  .fcard-o { --c: var(--openai-fill); }
