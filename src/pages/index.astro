---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Clip from '../components/Clip.astro';
import Replay from '../components/Replay.astro';
import Kite from '../components/Kite.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import Download from '../components/Download.astro';
import Terminal from '../components/Terminal.astro';
import { REPO, BLOB, ONE_LINER, VERSION_FALLBACK, CREW } from '../data/site.js';
import { FEATURES, FAMILIES, GOOGLE_TERMS, LINUX_LINE, WHATS_NEXT, RUN_TESTS } from '../data/copy.js';

const faqs = [
  {
    q: 'What is CrewKite?',
    a: `<p>A desktop workspace for coding with the agents you already pay for. It runs the Google, OpenAI and Anthropic clients you have signed in, plus a local model through LM Studio, as one crew on your own computer. A thread can move to another provider mid task and keep its messages and edited files.</p>`,
  },
  {
    q: 'Which plans work?',
    a: `<p>CrewKite adds no plan gate. Each family works on whatever plan its provider allows, and the provider's limits apply. CrewKite sets no API key and never falls back to paid API billing. The provider section above has the dated line for each family, and <a href="${BLOB}/docs/providers.md#plans-per-family">Provider routes</a> has the longer notes.</p>`,
  },
  {
    q: 'Do I sign in every time?',
    a: `<p>No. Connect each provider once on this computer with its Connect button in Settings. After that CrewKite reconnects on its own at every launch, and Local also reconnects by itself when LM Studio restarts. The OpenAI client runs in CrewKite's own home with its own sign-in, so nothing it does shows in your own OpenAI app.</p>`,
  },
  {
    q: 'Can I ask something while a model is working?',
    a: `<p>Yes. A side question runs beside the builder on the model you pick, such as gpt-oss-20b in LM Studio, and never stops it.</p>`,
  },
  {
    q: 'How does a handoff work?',
    a: `<p>Pick a model from another provider and send, or let the crew move the work when a provider runs out of included allowance. The next connected provider starts from your messages, the earlier answers, the list of changed files and the patches that still fit, in the same copy of your repository. <a href="${BLOB}/docs/continuity.md">Continuity and recovery</a> has the details.</p>`,
  },
  {
    q: 'Is my code sent anywhere?',
    a: `<p>Only where your provider's own client sends it when you run a turn on that provider. CrewKite has no telemetry, no account and no server of its own, and nothing is hosted. A Local thread stays on your computer. Every thread works in its own copy, and your checkout changes only when you accept a branch.</p>`,
  },
  {
    id: 'google-terms',
    q: 'Will my provider ban my account?',
    a: `<p>OpenAI, Anthropic and Local run through their own clients on their supported paths. Google is different. ${GOOGLE_TERMS}</p>`,
  },
  {
    q: 'Does it run on Linux or Windows?',
    a: `<p>The Linux preview runs on x64 and arm64 as DEB and RPM, with OpenAI, Anthropic and Local. Google is not on Linux. Windows is not supported yet. WSL2 is untested, so I cannot say whether the Linux preview runs there.</p>`,
  },
  {
    q: 'How do I update?',
    a: `<p>Choose Check for Updates in the app menu, or under Help on Linux. CrewKite also checks once a day. In 0.1.x an update is a download from <a href="/download">the download page</a>.</p>`,
  },
  {
    q: 'How do I uninstall it?',
    a: `<p>Quit the app, then remove the app, its data folder and its desktop profile. Thread refs in your repositories go with Delete in each thread's menu or one git command. <a href="${BLOB}/docs/preview.md#uninstall">The uninstall steps</a> list every location.</p>`,
  },
  {
    q: 'What license is it under?',
    a: `<p>The Apache License 2.0. The source, the docs and the architecture decision records are on <a href="${REPO}">GitHub</a>.</p>`,
  },
];
---
<Base title="CrewKite: one desktop workspace for Google, OpenAI, Anthropic and a local model" path="/">
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <a class="pill reveal" href="/download#new">
        <span class="pill-tag">New</span>
        <span>Version <span data-release="version">{VERSION_FALLBACK}</span></span>
        <Icon name="arrow" size={14} />
      </a>
      <h1 id="hero-h" class="reveal">One desktop workspace for <span class="n-g">Google</span>, <span class="n-o">OpenAI</span>, <span class="n-a">Anthropic</span> and <span class="n-l">a local model</span>.</h1>
      <p class="hero-sub reveal">{ONE_LINER}</p>
      <ul class="rchips reveal" aria-label="The crew in the release screens, with subagents on for every role">
        {CREW.map((c) => (
          <li class={`rchip rchip-${c.fam}`}>
            <span class={`fam fam-${c.fam}`}>{c.fam.toUpperCase()}</span>
            <span class="r-role">{c.role}</span>
            <span class="r-seg"><span class="r-fam">{c.family} </span><span class="mono">{c.model}</span></span>
            {c.effort && <span class="r-seg"><span class="sr">, </span>{c.effort}</span>}
          </li>
        ))}
      </ul>
      <p class="rchips-note reveal">Subagents on for every role. Flight mode Balanced.</p>
      <div class="hero-cta reveal">
        <Download variant="hero" />
        <a class="btn btn-ghost" href={REPO}>
          <Icon name="code" />View on GitHub
        </a>
      </div>
      <p class="hero-meta reveal">
        <span class="mono">v<span data-release="version">{VERSION_FALLBACK}</span></span>
        <span data-release="date-line" hidden></span>
        <span class="dlc" data-downloads hidden></span>
        <span>macOS on Apple silicon</span>
        <span>Linux preview</span>
        <a href="#terminal">CLI included</a>
        <a href="/download#verify">SHA-256 checksums</a>
      </p>
      <div class="hero-shot">
        <Replay />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" aria-labelledby="feat-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Features</span>
        <h2 id="feat-h" class="h2">What CrewKite does</h2>
        <p class="lede">Each provider's own client does the work, on your sign-in and your plan. CrewKite runs them as one crew, keeps the work moving at a limit, and keeps your checkout as it is until you accept a change.</p>
      </div>
      <ul class="fgrid">
        {FEATURES.map((f, i) => (
          <li class="fx reveal" style={`--d:${(i % 3) * 60}ms`}>
            <span class="fx-i"><Icon name={f.icon} size={20} /></span>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Providers -->
  <section id="providers" aria-labelledby="fam-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Providers</span>
        <h2 id="fam-h" class="h2">Run the clients you already sign in to</h2>
        <p class="lede">CrewKite starts each provider's own client with your sign-in and your plan. Each one connects once on this computer with an explicit Connect, then reconnects on its own at every later launch.</p>
      </div>
      <div class="fams">
        {FAMILIES.map((f, i) => (
          <article class={`fcard fcard-${f.key} reveal`} style={`--d:${i * 70}ms`}>
            <div class="fcard-top">
              <span class={`fam fam-${f.key}`}>{f.key.toUpperCase()}</span>
              <h3>{f.name}</h3>
              {f.linux && <span class="fcard-tag">{f.linux}</span>}
            </div>
            <p class="fcard-client">{f.client}</p>
            <p class="fcard-plan">{f.plan}</p>
            {f.aside && <p class="fcard-plan">{f.aside}</p>}
            {f.note && (
              <p class="fcard-note">
                <a href="#google-terms">Needs a terms acknowledgement in the app.</a>
              </p>
            )}
          </article>
        ))}
      </div>
      <p class="fams-note reveal">{LINUX_LINE}</p>

      <div class="blk blk-split reveal">
        <div class="blk-copy">
          <h3>Connect once</h3>
          <p>The welcome screen walks through each provider, and Settings keeps the same setup. CrewKite adds no plan requirement, so each family works on the plan its provider allows.</p>
          <h3 class="blk-h-2" id="google-route">The Google route</h3>
          <p set:html={GOOGLE_TERMS} />
        </div>
        <Shot id="welcome" />
      </div>

      <div class="blk reveal">
        <div class="blk-copy">
          <h3>What's next</h3>
          <ul class="next">
            {WHATS_NEXT.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- The crew and its plan -->
  <section id="crew" aria-labelledby="crew-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Crews</span>
        <h2 id="crew-h" class="h2">One crew, four providers</h2>
        <p class="lede">A crew is an orchestrator, a builder, a fixer, a reviewer and a challenger, plus the model that answers side questions. Each role runs on any family you have connected, with its own model and effort, and each can start subagents.</p>
      </div>

      <div class="blk blk-split reveal">
        <div class="blk-copy">
          <h3>The crew in these screens</h3>
          <ul class="crew-list">
            {CREW.map((c) => (
              <li><span class={`fam fam-${c.fam}`} aria-hidden="true">{c.fam.toUpperCase()}</span><b>{c.role}</b><span>{c.family} <span class="mono">{c.model}</span>{c.effort && `, ${c.effort}`}</span></li>
            ))}
          </ul>
          <p class="crew-sub">Subagents on for every role. Flight mode Balanced.</p>
        </div>
        <Shot id="crew-editor" />
      </div>

      <div class="blk blk-split blk-rev reveal">
        <div class="blk-copy">
          <h3>A plan in slices</h3>
          <p>In the Full crew preset the orchestrator reads the request and proposes up to 8 slices. The controller checks the plan and assigns each slice to the crew's builder, or to its fixer for a hard slice, and nothing runs until you press Run plan.</p>
        </div>
        <Shot id="plan" />
      </div>

      <div class="blk reveal">
        <div class="blk-copy">
          <h3>Presets and effort</h3>
          <p>The built-in presets are Solo, Tandem and Full crew. Save your own crews beside them, and set each role's model and effort.</p>
        </div>
        <Shot id="builder-effort" />
      </div>
    </div>
  </section>

  <!-- Allowances and handoff -->
  <section id="allowances" aria-labelledby="allow-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Allowances</span>
        <h2 id="allow-h" class="h2">Keeps going at the limit</h2>
        <p class="lede">A crew moves work to the next connected provider when one runs out of included allowance, and the rail shows every window as it goes.</p>
      </div>

      <div class="blk blk-split reveal">
        <div class="blk-copy">
          <h3>Continue on the next provider</h3>
          <p>When Anthropic reaches its limit, the thread continues on OpenAI with every message and edited file, and the next reply picks up where the last one stopped.</p>
        </div>
        <figure class="feat-vis vis-hand">
          <div class="ht ht-from" aria-hidden="true"><div class="ht-h"><span class="fam fam-a">A</span>Anthropic · Opus 5.5<span class="ht-lim">Limit reached</span></div><b></b><b></b></div>
          <div class="hand-line" aria-hidden="true"><span>Continued on OpenAI (gpt-6.1-sol) from Anthropic (Opus 5.5). Reason: usage limit reached.</span></div>
          <div class="ht ht-to" aria-hidden="true"><div class="ht-h"><span class="fam fam-o">O</span>OpenAI · gpt-6.1-sol<span class="ht-carry"><span class="mono">12 messages</span><span class="mono">3 files</span></span></div><b></b><b></b><b></b></div>
          <figcaption class="vis-cap">Illustration of a handoff, drawn for this page.</figcaption>
        </figure>
      </div>

      <div class="blk reveal">
        <div class="blk-copy">
          <h3>Every allowance in view</h3>
          <p>The rail shows the five-hour and weekly windows each provider reports, or the weekly and model windows for a plan with no five-hour limit. Google reports five-hour and weekly windows, OpenAI a weekly window, Anthropic the windows its plan has, and Local has no limits. CrewKite reads usage every 90 seconds for Google and OpenAI and every five minutes for Anthropic.</p>
        </div>
        <Shot id="anthropic-rail" />
        <div class="shots shots-2">
          <Shot id="google-allowance" />
          <Shot id="openai-allowance" />
        </div>
        <p class="blk-note">Gauge readings in these screens are samples from a test account.</p>
      </div>

      <div class="blk blk-split reveal" id="credits">
        <div class="blk-copy">
          <h3>Credits stay off</h3>
          <p>Allow credit spending is a switch for OpenAI and for Anthropic, and it starts off. With it off, a step that would spend credits moves to another provider before it starts. The provider's own setting still decides, and CrewKite cannot turn credits on there.</p>
        </div>
        <Clip id="credit-continuation" />
      </div>

      <div class="blk blk-split blk-rev reveal" id="meter">
        <div class="blk-copy">
          <h3>Next message meter</h3>
          <p>The kite meter beside Send shows what the next message will use against the model's context window, separate from your plan's allowance. Here a side question runs on gpt-oss-20b in LM Studio beside the thread, and the builder keeps working.</p>
        </div>
        <Shot id="kite-meter" />
      </div>
    </div>
  </section>

  <!-- Review and accept -->
  <section id="review" aria-labelledby="review-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Review</span>
        <h2 id="review-h" class="h2">Nothing lands until you accept it</h2>
        <p class="lede">Every thread works in its own copy of your repository. Read the changes, keep or drop each file, then accept them to a new local branch. Your checkout stays as it is.</p>
      </div>
      <div class="blk reveal">
        <Shot id="changes" />
      </div>
      <div class="blk cs-git reveal">
        <Shot id="accepted" />
        <div class="git-vis">
          <svg viewBox="0 0 600 200" role="img" aria-label="Illustration: the thread's copy starts from your base commit. Your checkout stays unchanged. Accept commits the result on a new local branch.">
            <path class="g-line g-main" d="M40 44 H570" />
            <path class="g-line g-scratch" pathLength="1" d="M60 44 C 92 44, 96 156, 132 156 H 352" />
            <path class="g-line g-branch" pathLength="1" d="M438 156 C 470 156, 470 100, 500 100 H 528" />
            <circle class="g-base" cx="60" cy="44" r="7" />
            <circle class="g-o" cx="186" cy="156" r="6" />
            <circle class="g-g" cx="236" cy="156" r="6" />
            <circle class="g-o" cx="290" cy="156" r="6" />
            <rect class="g-accept" x="352" y="140" width="86" height="32" rx="8" />
            <text class="g-accept-t" x="395" y="161" text-anchor="middle">Accept</text>
            <circle class="g-new" cx="538" cy="100" r="7" />
            <text class="g-t" x="60" y="24" text-anchor="middle">base commit</text>
            <text class="g-t g-t-r" x="570" y="30" text-anchor="end">your checkout, unchanged</text>
            <text class="g-t" x="236" y="190" text-anchor="middle">the thread's copy: edits, tests, review</text>
            <text class="g-t g-t-acc" x="538" y="80" text-anchor="middle">new local branch</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Control -->
  <section id="control" aria-labelledby="control-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Control</span>
        <h2 id="control-h" class="h2">You set the pace</h2>
        <p class="lede">Flight mode decides how much the crew does on its own, and Permissions decides which commands it may run without asking.</p>
      </div>
      <div class="blk blk-split blk-ctl reveal">
        <Shot id="control" />
        <Clip id="permission-gate" />
      </div>
    </div>
  </section>

  <!-- Run tests -->
  <section id="run-tests" aria-labelledby="tests-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Run tests</span>
        <h2 id="tests-h" class="h2">Run tests on demand</h2>
        <p class="lede">{RUN_TESTS}</p>
      </div>
    </div>
  </section>

  <!-- Why I built it -->
  <section id="why-built" class="built" aria-labelledby="built-h">
    <div class="wrap">
      <div class="built-col reveal">
        <h2 id="built-h" class="built-h">Why I built it</h2>
        <div class="built-text">
          <p>I build products for underserved niche markets, and I start each one by talking with the people who have the problem. Along the way I kept running into problems in my own workflow that no tool solved.</p>
          <p>I work across several AI subscriptions and a local model, because each one is strongest at something different: backend work, frontend and design, or catching defects in review. Using them together on one repository meant separate apps and terminals, watching every usage meter, and writing handoffs by hand. Each new agent reread the whole context, and the style of the work drifted with every switch.</p>
          <p>CrewKite is the controller I wanted: every provider in one thread, held to how I want my work done. Its review methods draw on open-source projects like multi, ADHD and Ponytail, <a href="https://github.com/rjk6831/crewkite/blob/main/docs/credits.md">credited in the docs</a>, so you get those ideas without having to find them first.</p>
          <p>CrewKite is free and open source. Other people's open-source work has helped me a great deal, and this is my turn to give back. I am measuring efficiency with a benchmark now, and I will not claim gains until the numbers are in. Until then, what I want most is your feedback. My best product decisions have come from real people telling me what they need. Try it, and tell me where it falls short.</p>
          <p class="built-sig">Raymond J. Kraft</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Safety -->
  <section id="safety" aria-labelledby="safe-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Safety</span>
        <h2 id="safe-h" class="h2">Safe with your repository and your accounts</h2>
      </div>
      <div class="safe">
        <article class="scard reveal"><Icon name="branch" size={22} /><h3>Your checkout stays as it is</h3><p>Every thread works in its own copy. Results land as new local branches, and only when you accept them.</p></article>
        <article class="scard reveal" style="--d:70ms"><Icon name="eye" size={22} /><h3>Nothing leaves your machine except what your provider client sends</h3><p>No telemetry, no account, no server of its own.</p></article>
        <article class="scard reveal" style="--d:140ms"><Icon name="key" size={22} /><h3>Secrets are redacted</h3><p>Tool output, exports and diagnostics go through redaction before they are shown or saved.</p></article>
        <article class="scard reveal" style="--d:210ms"><Icon name="lock" size={22} /><h3>Each provider's own client runs with your own sign-in</h3><p>CrewKite never reads or stores a provider credential and never falls back to paid API billing.</p></article>
      </div>
      <p class="reveal more"><a class="arrow-link" href="/safety">How CrewKite handles authority <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- Terminal -->
  <section id="terminal" aria-labelledby="term-h">
    <div class="wrap term-grid">
      <div class="reveal">
        <span class="eyebrow">Terminal too</span>
        <h2 id="term-h" class="h2">The same crews and threads from a CLI</h2>
        <p class="lede">The CLI talks to the same controller as the desktop, so keep the desktop open. Slash commands such as <code>/model</code>, <code>/crew</code> and <code>/ask</code>, file mentions with <code>@</code>, and <code>-p</code> for scripts.</p>
        <div class="cmd term-cmd"><code>pnpm crewkite</code><button class="copy" type="button" data-copy="pnpm crewkite" hidden><Icon name="copy" size={13} />Copy</button></div>
        <div class="cmd term-cmd"><code>pnpm crewkite thread list --json</code><button class="copy" type="button" data-copy="pnpm crewkite thread list --json" hidden><Icon name="copy" size={13} />Copy</button></div>
        <p class="small">From a source checkout, inside a project you added. <a href={`${BLOB}/docs/preview.md#try-the-cli`}>Try the CLI</a> walks through it, and <a href={`${BLOB}/apps/cli/README.md`}>the CLI guide</a> lists every key and command.</p>
      </div>
      <div class="reveal">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section id="open" aria-labelledby="open-h">
    <div class="wrap">
      <div class="os reveal">
        <div class="os-copy">
          <span class="eyebrow">Open source</span>
          <h2 id="open-h" class="h2">Apache 2.0, built in the open</h2>
          <p class="lede">Version 0.1.0 is the first public release. I build CrewKite in the open, every decision has an architecture decision record, and an extension seam lets separately licensed modules plug in.</p>
          <div class="os-links">
            <a class="arrow-link" href={REPO}>Source <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/CONTRIBUTING.md`}>Contributing <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/docs/adr/README.md`}>Decision records <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/docs/extensions.md`}>Extension seam <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <dl class="os-stats">
          <div><dt>License</dt><dd>Apache 2.0</dd></div>
          <div><dt>Version</dt><dd class="mono" data-release="version">{VERSION_FALLBACK}</dd></div>
          <div><dt>Telemetry</dt><dd>None</dd></div>
          <div><dt>Account</dt><dd>None</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div class="reveal">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-h" class="h2">Questions</h2>
        <p class="lede">The rest is in the <a href="/docs">docs</a>.</p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="reveal" id={f.id}>
            <summary><span>{f.q}</span><Icon name="plus" size={18} /></summary>
            <div class="faq-a" set:html={f.a} />
          </details>
        ))}
        <details class="reveal">
          <summary><span>How do I reach you?</span><Icon name="plus" size={18} /></summary>
          <div class="faq-a">
            <p>Email me at <Email />. Open an issue on <a href={`${REPO}/issues`}>GitHub</a> for bugs and requests. Report a security issue privately through GitHub as <a href={`${BLOB}/SECURITY.md`}>SECURITY.md</a> describes, never by email or in a public issue.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final call -->
  <section class="final" aria-labelledby="final-h">
    <div class="wrap">
      <div class="final-box reveal">
        <Kite size={56} class="final-kite" />
        <h2 id="final-h" class="h2">Download CrewKite <span data-release="version">{VERSION_FALLBACK}</span></h2>
        <p class="lede">macOS on Apple silicon, signed and notarized. Linux x64 and arm64 preview. Windows is not supported yet.</p>
        <div class="hero-cta">
          <Download variant="final" />
          <a class="btn btn-ghost" href="/download">All builds and checksums</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: var(--space-16) 0 var(--space-section);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -10% 0 auto;
    height: 900px;
    background:
      radial-gradient(ellipse 50% 40% at 50% 30%, var(--glow), transparent 70%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 25%, var(--mask-ink) 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 25%, var(--mask-ink) 20%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color var(--duration-fast);
  }
  .pill:hover { border-color: var(--accent); color: var(--text); }
  .pill-tag {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
  }
  h1 {
    margin-top: var(--space-8);
    max-width: 20ch;
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    font-weight: var(--weight-bold);
  }
  .n-o { color: var(--family-openai); }
  .n-a { color: var(--family-anthropic); }
  .n-g { color: var(--family-google); }
  .n-l { color: var(--family-local); }
  /* Role chips drawn like the app's: family mark, role in the family color, then segments split by
     hairlines. They are labels, so nothing about them invites a click. */
  .rchips {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: center;
    gap: var(--space-3);
  }
  .rchip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: var(--text-sm);
    color: var(--text-muted);
    white-space: nowrap;
    cursor: default;
    user-select: none;
  }
  .rchips-note { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--text-dim); }
  .rchip .fam { width: 20px; height: 20px; font-size: var(--text-2xs); border-radius: var(--radius-sm); margin-right: var(--space-2); }
  .r-role { font-weight: var(--weight-semibold); color: var(--c); padding-right: var(--space-3); }
  .r-seg { padding: 0 var(--space-3); border-left: 1px solid var(--border-strong); color: var(--text); white-space: nowrap; }
  .r-seg .mono { font-size: var(--text-xs); }
  .rchip-o { --c: var(--family-openai); }
  .rchip-a { --c: var(--family-anthropic); }
  .rchip-g { --c: var(--family-google); }
  .rchip-l { --c: var(--family-local); }
  @keyframes chip { from { transform: scaleX(0); } }
  .hero-sub {
    margin-top: var(--space-6);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .hero-cta {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
  .hero-meta {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-dim);
  }
  .hero-meta a { color: var(--text-muted); text-underline-offset: 3px; }
  .hero-shot {
    margin-top: var(--space-16);
    width: 100%;
    max-width: 1080px;
    perspective: 1600px;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-shot :global(.replay) {
        animation: tilt linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
        transform-origin: 50% 0;
      }
      @keyframes tilt {
        from { transform: rotateX(16deg) scale(0.94); opacity: 0.6; }
        to { transform: none; opacity: 1; }
      }
    }
  }
  .js .hero .reveal { transition-delay: calc(var(--i, 0) * 60ms); }

  /* Providers */
  .fams {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .fcard {
    position: relative;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    overflow: hidden;
    transition-delay: var(--d, 0ms);
    transition-property: opacity, transform, border-color;
  }
  .fcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--c);
  }
  .fcard::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px 160px at 50% -40px, color-mix(in srgb, var(--c) 16%, transparent), transparent);
    opacity: 0;
    transition: opacity var(--duration-moderate);
    pointer-events: none;
  }
  .fcard:hover { border-color: color-mix(in srgb, var(--c) 50%, var(--border)); }
  .fcard:hover::after { opacity: 1; }
  .fcard-o { --c: var(--family-openai-fill); }
  .fcard-a { --c: var(--family-anthropic-fill); }
  .fcard-g { --c: var(--family-google-fill); }
  .fcard-l { --c: var(--family-local-fill); }
  .fcard-top { display: flex; align-items: center; gap: var(--space-3); }
  .fcard-top .fam { width: 24px; height: 24px; font-size: var(--text-xs); border-radius: var(--radius-sm); }
  .fcard h3 { font-size: var(--text-xl); }
  .fcard-client { font-weight: var(--weight-medium); font-size: var(--text-ui); }
  .fcard-plan { font-size: var(--text-md); color: var(--text-muted); }
  .fcard-note {
    margin-top: auto;
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
  }
  .fcard-note a { color: var(--text); font-weight: var(--weight-semibold); text-underline-offset: 3px; }
  .fams-note {
    margin-top: var(--space-6);
    font-size: var(--text-ui);
    color: var(--text-muted);
    text-align: center;
  }

  /* Feature cards: twelve, three across on wide screens. */
  .fgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .fx {
    position: relative;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    transition-delay: var(--d, 0ms);
    transition-property: opacity, transform, border-color;
  }
  .fx:hover { border-color: var(--border-strong); }
  .fx-i {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .fx h3 { margin-top: var(--space-4); font-size: var(--text-lg); line-height: var(--text-lg-lh); }
  .fx h3 a { color: inherit; text-decoration: none; }
  .fx h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .fx h3 a:focus-visible { outline: none; }
  .fx:has(a:focus-visible) { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .fx p { margin-top: var(--space-2); font-size: var(--text-md); line-height: var(--text-md-lh); color: var(--text-muted); }
  @media (max-width: 1023px) { .fgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .fgrid { grid-template-columns: minmax(0, 1fr); } }

  /* Longer sections: copy with its media, stacked or side by side. Sub-blocks sit --space-block apart. */
  .blk { display: grid; gap: var(--space-6); padding: var(--space-block) 0; }
  .blk + .blk { border-top: 1px solid var(--border); }
  .section-head + .blk { padding-top: 0; }
  .blk-split { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-12); align-items: start; }
  .blk-rev { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  .blk-rev > .blk-copy { order: 2; }
  .blk-ctl { grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr); }
  .blk-copy { max-width: var(--measure); }
  .blk-copy h3 { font-size: var(--text-h3); line-height: var(--text-h3-lh); }
  .blk-copy p { margin-top: var(--space-3); color: var(--text-muted); }
  .blk-copy :global(a) { color: var(--text); text-underline-offset: 3px; }
  .blk-h-2 { margin-top: var(--space-8); }
  .blk-note { font-size: var(--text-sm); color: var(--text-dim); }
  .next { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-3); color: var(--text-muted); }
  .next li { position: relative; padding-left: var(--space-6); }
  .next li::before { content: ''; position: absolute; left: var(--space-1); top: 0.7em; width: 6px; height: 6px; border-radius: var(--radius-sm); background: var(--accent); }
  .fcard-tag { margin-left: auto; padding: var(--space-0-5) var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--border-strong); font-size: var(--text-xs); color: var(--text-muted); }
  .feat-vis {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background:
      radial-gradient(500px 220px at 70% 0%, var(--glow), transparent),
      var(--sidebar);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    overflow: hidden;
  }
  .vis-cap { font-size: var(--text-xs); color: var(--text-dim); }
  @media (max-width: 1023px) {
    .blk-split, .blk-ctl { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .blk-rev > .blk-copy { order: 0; }
  }

  /* 01 handoff */
  .ht {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .ht-h { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--text-muted); margin-bottom: var(--space-0-5); }
  .ht-h .fam { width: 16px; height: 16px; font-size: var(--text-2xs); }
  .ht b { height: 7px; border-radius: var(--radius-sm); background: var(--border-strong); }
  .ht b:nth-of-type(1) { width: 85%; }
  .ht b:nth-of-type(2) { width: 62%; }
  .ht b:nth-of-type(3) { width: 74%; }
  .ht-lim { margin-left: auto; font-size: var(--text-xs); color: var(--red); }
  .ht-carry { margin-left: auto; display: flex; gap: var(--space-2); }
  .ht-carry span { font-size: var(--text-xs); padding: var(--space-0-5) var(--space-2); border-radius: var(--radius-lg); border: 1px solid var(--border-strong); color: var(--text-muted); }
  .ht-from b { background: var(--border); }
  .ht-to { border-color: color-mix(in srgb, var(--family-openai) 45%, var(--border)); }
  .hand-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: center;
  }
  .hand-line::before,
  .hand-line::after {
    content: '';
    flex: 1;
    height: 1px;
    min-width: 12px;
    background: linear-gradient(90deg, var(--family-anthropic), var(--family-openai));
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .vis-hand .hand-line, .js .vis-hand .ht-to, .js .vis-hand .ht-carry span { opacity: 0; transform: translateY(6px); transition: all var(--duration-slow) var(--ease-out); }
    .js .in .vis-hand .hand-line { opacity: 1; transform: none; transition-delay: var(--duration-slow); }
    .js .in .vis-hand .ht-to { opacity: 1; transform: none; transition-delay: var(--duration-slower); }
    .js .in .vis-hand .ht-carry span { opacity: 1; transform: none; transition-delay: 1300ms; }
    .js .in .vis-hand .ht-carry span + span { transition-delay: 1500ms; }
  }

  /* Crews, settings and git */
  .cs-row {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-block) 0;
  }
  .cs-row + .cs-row { border-top: 1px solid var(--border); }
  .cs-copy { max-width: var(--measure); }
  .cs-copy h3 { font-size: var(--text-h3); }
  .crew-list { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: var(--space-2); font-size: var(--text-md); }
  .crew-list li { display: grid; grid-template-columns: 20px 11ch 1fr; align-items: center; gap: var(--space-3); }
  .crew-list .fam { width: 20px; height: 20px; font-size: var(--text-2xs); border-radius: var(--radius-sm); }
  .crew-list b { font-weight: var(--weight-semibold); }
  .crew-list .mono { font-size: var(--text-sm); }
  .crew-sub { font-size: var(--text-sm); color: var(--text-dim); }
  .cs-copy p { margin-top: var(--space-3); color: var(--text-muted); }
  .shots { display: grid; gap: var(--space-6); align-items: start; }
  .shots-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shots-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cs-git {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: center;
    gap: var(--space-12);
  }
  .git-vis {
    padding: var(--space-6) var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--sidebar);
  }
  .git-vis svg { width: 100%; height: auto; overflow: visible; }
  .g-line { fill: none; stroke-width: 2.5; stroke-linecap: round; }
  .g-main { stroke: var(--border-strong); }
  .g-scratch { stroke: var(--text-dim); stroke-dasharray: 1; }
  .g-branch { stroke: var(--accent); stroke-dasharray: 1; }
  .g-base { fill: var(--text-muted); }
  .g-o { fill: var(--family-openai-fill); }
  .g-l { fill: var(--family-local-fill); }
  .g-g { fill: var(--family-google-fill); }
  .g-new { fill: var(--accent); }
  .g-accept { fill: var(--accent); }
  .g-accept-t { fill: var(--accent-ink); font: 600 var(--text-md) var(--font-sans); }
  .g-t { fill: var(--text-muted); font: 500 var(--text-sm) var(--font-sans); }
  .g-t-acc { fill: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .js .cs-git .g-scratch,
    .js .cs-git .g-branch { stroke-dashoffset: 1; transition: stroke-dashoffset var(--duration-slower) var(--ease-out); }
    .js .cs-git.in .g-scratch { stroke-dashoffset: 0; transition-delay: var(--duration-base); }
    .js .cs-git.in .g-branch { stroke-dashoffset: 0; transition-delay: 1100ms; }
    .js .cs-git .g-new,
    .js .cs-git .g-t-acc { opacity: 0; transition: opacity 400ms var(--ease-out) 1900ms; }
    .js .cs-git.in .g-new,
    .js .cs-git.in .g-t-acc { opacity: 1; }
  }
  @media (max-width: 1023px) {
    .shots-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-git { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  }
  @media (max-width: 767px) {
    .shots-2, .shots-3 { grid-template-columns: minmax(0, 1fr); }
    .git-vis { padding: var(--space-4); }
  }

  /* Why I built it */
  /* One column on phones, two from 768 px. Each column holds about 49ch, close to 65 characters of
     Inter at 16 px, since ch is the width of a zero. Paragraphs never split across columns. */
  .built-col {
    max-width: 49ch;
    text-align: left;
  }
  @media (min-width: 768px) {
    .built-col { max-width: calc(2 * 49ch + 56px); }
    .built-text {
      column-count: 2;
      column-gap: var(--space-16);
    }
    .built-text p { break-inside: avoid; }
    .built-col .built-text p { margin: 0 0 var(--space-4); }
    .built-col .built-text .built-sig { margin: var(--space-2) 0 0; }
  }
  .built-h {
    font-size: var(--text-h3);
    margin-bottom: var(--space-6);
  }
  .built-col p {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text);
  }
  .built-col p + p { margin-top: var(--space-4); }
  .built-col a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }
  .built-col .built-sig {
    margin-top: var(--space-6);
    font-weight: var(--weight-light);
    color: var(--text-muted);
  }

  /* Safety */
  .safe {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .scard {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    transition-delay: var(--d, 0ms);
  }
  .scard :global(svg) { color: var(--accent); }
  .scard h3 { margin-top: var(--space-4); font-size: var(--text-lg); line-height: 1.3; }
  .scard p { margin-top: var(--space-2); color: var(--text-muted); font-size: var(--text-ui); }
  .more { margin-top: var(--space-8); }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }
  .arrow-link :global(svg) { transition: transform var(--duration-fast) var(--ease-out); }
  .arrow-link:hover :global(svg) { transform: translateX(3px); }

  /* Terminal */
  .term-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-16);
    align-items: center;
  }
  .term-grid > *, .feat > *, .faq-grid > *, .os > * { min-width: 0; }
  .term-cmd { margin-top: var(--space-8); max-width: 360px; }
  .small { margin-top: var(--space-3); font-size: var(--text-md); color: var(--text-dim); }
  .small a { color: var(--text-muted); }
  .lede code { color: var(--text); }

  /* Open source */
  .os {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    padding: var(--space-12);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background:
      radial-gradient(600px 300px at 0% 0%, var(--glow), transparent),
      var(--surface);
  }
  .os-links { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); }
  .os-stats {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    align-self: center;
  }
  .os-stats > div { background: var(--surface-raised); padding: var(--space-6); }
  .os-stats dt { font-size: var(--text-xs); color: var(--text-dim); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .os-stats dd { margin: var(--space-2) 0 0; font-size: var(--text-xl); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-snug); }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-16); align-items: start; }
  .faq { border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-1);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(svg) { color: var(--text-dim); transition: transform 220ms var(--ease-out); flex: none; }
  .faq details[open] summary :global(svg) { transform: rotate(45deg); color: var(--accent); }
  .faq summary:hover span { color: var(--accent); }
  .faq-a { padding: 0 var(--space-1) var(--space-6); color: var(--text-muted); max-width: var(--measure); }
  .faq-a :global(a) { color: var(--text); text-underline-offset: 3px; }
  .faq details::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 280ms var(--ease-out), content-visibility 280ms allow-discrete;
  }
  .faq details[open]::details-content { block-size: auto; }
  :global(html) { interpolate-size: allow-keywords; }

  /* Final */
  .final-box {
    position: relative;
    text-align: center;
