---
import Base from '../layouts/Base.astro';
import Replay from '../components/Replay.astro';
import Kite from '../components/Kite.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import Download from '../components/Download.astro';
import Terminal from '../components/Terminal.astro';
import { REPO, BLOB, ONE_LINER, VERSION_FALLBACK } from '../data/site.js';

const families = [
  {
    key: 'o', name: 'OpenAI', client: 'Codex, through its app-server client',
    plan: 'As of 31 October 2026, OpenAI says its coding client is included in its Free, Go, Plus, Pro, Business, Edu and Enterprise plans. Usage limits depend on the plan, the model and the task.',
  },
  {
    key: 'a', name: 'Anthropic', client: 'Claude Code, through its stream-json mode',
    plan: 'As of 31 October 2026, Anthropic includes its coding client in its Pro, Max, Team and Enterprise plans and leaves it out of Free. Pro and Max have a five-hour limit and a weekly limit that the Anthropic chat app shares.',
  },
  {
    key: 'g', name: 'Google', client: 'Antigravity, through the Agent Client Protocol',
    plan: 'As of 31 October 2026, Google gives accounts without a paid plan a quota that refreshes weekly. Google AI Pro refreshes every five hours until a weekly limit, and Google AI Ultra has the highest quota. Limits follow available capacity.',
    note: true,
  },
  {
    key: 'l', name: 'Local', client: 'LM Studio, on this computer',
    plan: 'As of 31 October 2026, LM Studio is free to use at home and at work. Speed and context follow your hardware.',
  },
];

const faqs = [
  {
    q: 'What is CrewKite?',
    a: `<p>A desktop workspace for coding with the agents you already pay for. It runs the OpenAI, Anthropic and Google clients you have signed in, plus a local model through LM Studio, as threads on your own computer. A thread can move to another provider mid task and keep its messages and edited files.</p>`,
  },
  {
    q: 'Which plans work?',
    a: `<p>CrewKite adds no plan gate. Each family works on whatever plan its provider allows, and the provider's limits apply. CrewKite sets no API key and never falls back to paid API billing. The provider section above has the dated line for each family, and <a href="${BLOB}/docs/providers.md#plans-per-family">Provider routes</a> has the longer notes.</p>`,
  },
  {
    q: 'Is my code sent anywhere?',
    a: `<p>Only where your provider's own client sends it when you run a turn on that provider. CrewKite has no telemetry, no account and no server of its own, and nothing is hosted. A Local thread stays on your computer. Models work in a scratch copy, and your checkout changes only when you accept a branch.</p>`,
  },
  {
    q: 'Is this a wrapper?',
    a: `<p>CrewKite runs each vendor's own client on purpose, so your sign-in, your plan and the vendor's terms stay yours. What it adds is one thread that passes work between providers, plan slices that run side by side, one controller that holds every permission, a scratch copy for each thread and a branch you review before anything touches your code.</p>`,
  },
  {
    id: 'google-terms',
    q: 'Will my provider ban my account?',
    a: `<p>OpenAI, Anthropic and Local run through their own clients on their supported paths. Google is different. Google's third-party access FAQ says that third-party access through its coding client login violates its terms. Google does not name CrewKite, and CrewKite has no exception from Google. Using the Google route is your own choice and your own risk, and the app keeps it off until you tick a box that says so. <a href="${BLOB}/docs/providers.md#google-and-your-account">Read the full text</a>.</p>`,
  },
  {
    q: 'Does it run on Linux or Windows?',
    a: `<p>The Linux preview runs on x64 and arm64 with OpenAI, Anthropic and Local. Google is not on Linux yet. Windows is not supported yet. WSL2 is untested, so I cannot say whether the Linux preview runs there.</p>`,
  },
  {
    q: 'How does a handoff work?',
    a: `<p>Pick a model from another provider and send, or let the thread move by itself when a provider reaches its limit. The new provider starts from your messages, the earlier answers, the list of changed files and the patches that still fit, in the same scratch copy. When you return to a provider, it resumes its own session and gets the turns it missed. <a href="${BLOB}/docs/continuity.md">Continuity and recovery</a> has the details.</p>`,
  },
  {
    q: 'How do I uninstall it?',
    a: `<p>Quit the app, then remove the app, its data folder and its desktop profile. Thread refs in your repositories go with Delete in each thread's menu or one git command. <a href="${BLOB}/docs/preview.md#uninstall">The uninstall steps</a> list every location.</p>`,
  },
  {
    q: 'What license is it under?',
    a: `<p>The Apache License 2.0. The source, the docs and the architecture decision records are on <a href="${REPO}">GitHub</a>.</p>`,
  },
];
---
<Base title="CrewKite: one desktop workspace for OpenAI, Anthropic, Google and a local model" path="/">
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <a class="pill reveal" href="/changelog">
        <span class="pill-tag">Prerelease</span>
        <span>Version <span data-release="version">{VERSION_FALLBACK}</span></span>
        <Icon name="arrow" size={14} />
      </a>
      <h1 id="hero-h" class="reveal">One desktop workspace for <span class="n-o">OpenAI</span>, <span class="n-a">Anthropic</span>, <span class="n-g">Google</span> and <span class="n-l">a local model</span>.</h1>
      <p class="hero-sub reveal">Run the coding agents you already pay for as threads on your own computer. When one hits its limit, the thread moves to the next with every message and edited file.</p>
      <ul class="fchips reveal" aria-label="Provider families">
        <li class="fchip fchip-o"><span class="fam fam-o">O</span>OpenAI</li>
        <li class="fchip fchip-a"><span class="fam fam-a">A</span>Anthropic</li>
        <li class="fchip fchip-g"><span class="fam fam-g">G</span>Google</li>
        <li class="fchip fchip-l"><span class="fam fam-l">L</span>Local<span class="inf" aria-label="no limits">∞</span></li>
      </ul>
      <div class="hero-cta reveal">
        <Download variant="hero" />
        <a class="btn btn-ghost" href={REPO}>
          <Icon name="code" />View on GitHub<span class="count" data-stars hidden></span>
        </a>
      </div>
      <p class="hero-meta reveal">
        <span class="mono">v<span data-release="version">{VERSION_FALLBACK}</span></span>
        <span data-release="date-line" hidden></span>
        <span>macOS on Apple silicon</span>
        <span>Linux preview</span>
        <a href="#terminal">CLI included</a>
        <a href="/download#verify">SHA-256 checksums</a>
      </p>
      <div class="hero-shot">
        <Replay />
      </div>
    </div>
  </section>

  <!-- Providers -->
  <section id="providers" aria-labelledby="fam-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Providers</span>
        <h2 id="fam-h" class="h2">Run the clients you already sign in to</h2>
        <p class="lede">CrewKite starts each provider's own client with your sign-in and your plan. Model and effort lists come live from each client, so a new model shows up the day the provider serves it.</p>
      </div>
      <div class="fams">
        {families.map((f, i) => (
          <article class={`fcard fcard-${f.key} reveal`} style={`--d:${i * 70}ms`}>
            <div class="fcard-top">
              <span class={`fam fam-${f.key}`}>{f.key.toUpperCase()}</span>
              <h3>{f.name}</h3>
            </div>
            <p class="fcard-client">{f.client}</p>
            <p class="fcard-plan">{f.plan}</p>
            {f.note && (
              <p class="fcard-note">
                <a href="#google-terms">Needs a terms acknowledgement in the app.</a>
              </p>
            )}
          </article>
        ))}
      </div>
      <p class="fams-note reveal">CrewKite has no plan gate. Each provider decides what its free plan includes.</p>
    </div>
  </section>

  <!-- What it adds -->
  <section id="adds" aria-labelledby="adds-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Why CrewKite</span>
        <h2 id="adds-h" class="h2">What CrewKite does for you</h2>
        <p class="lede">Each provider's own app does the work, on your sign-in and your plan. CrewKite runs them in one thread, tracks what each plan has left, and checks every change before it reaches your repository.</p>
      </div>

      <div class="feat reveal">
        <div class="feat-copy">
          <span class="feat-n mono">01</span>
          <h3>Keep working when a limit hits</h3>
          <p>When OpenAI stops at its five-hour limit, the thread moves to Anthropic with every message and edited file, and the next reply picks up where the last one stopped. Pick a rule once, such as most allowance left or Local first, and CrewKite does the switch for you.</p>
        </div>
        <div class="feat-vis vis-hand" aria-hidden="true">
          <div class="ht ht-o"><div class="ht-h"><span class="fam fam-o">O</span>OpenAI<span class="ht-lim">5 h limit reached</span></div><b></b><b></b></div>
          <div class="hand-line"><span>Continued on Anthropic from OpenAI. Reason: five-hour limit reached.</span></div>
          <div class="ht ht-a"><div class="ht-h"><span class="fam fam-a">A</span>Anthropic<span class="ht-carry"><span class="mono">12 messages</span><span class="mono">3 files</span></span></div><b></b><b></b><b></b></div>
          <div class="hand-mode"><span>Handoff mode</span><b>Most allowance left</b></div>
        </div>
      </div>

      <div class="feat feat-rev reveal">
        <div class="feat-copy">
          <span class="feat-n mono">02</span>
          <h3>See what every plan has left</h3>
          <p>Five-hour and weekly windows for all four providers sit in one rail, each with the time to its reset. Spend the allowance that resets soonest and stop checking four apps to find one with room.</p>
        </div>
        <div class="feat-vis vis-allow" aria-hidden="true">
          <div class="al" style="--c:var(--openai-fill)"><div class="al-h"><span class="fam fam-o">O</span>OpenAI<span>resets in 1 h 40 min</span></div><div class="al-r"><i style="--v:0"><em></em></i><span>5 h 0%</span></div><div class="al-r"><i style="--v:80"><em></em></i><span>week 80%</span></div></div>
          <div class="al" style="--c:var(--anthropic-fill)"><div class="al-h"><span class="fam fam-a">A</span>Anthropic<span>resets in 2 h</span></div><div class="al-r"><i style="--v:30"><em></em></i><span>30% left</span></div></div>
          <div class="al" style="--c:var(--google-fill)"><div class="al-h"><span class="fam fam-g">G</span>Google<span>resets in 3 d</span></div><div class="al-r"><i style="--v:85"><em></em></i><span>5 h 85%</span></div><div class="al-r"><i style="--v:65"><em></em></i><span>week 65%</span></div></div>
          <div class="al" style="--c:var(--local-fill)"><div class="al-h"><span class="fam fam-l">L</span>Local<span>on this computer</span></div><div class="al-r al-inf"><i style="--v:100"><em></em></i><b>∞</b><i style="--v:100"><em></em></i><span>No limits</span></div></div>
        </div>
      </div>

      <div class="feat reveal">
        <div class="feat-copy">
          <span class="feat-n mono">03</span>
          <h3>Nothing lands until you accept it</h3>
          <p>Every thread works in its own copy of your repository. Read the diff, keep or drop each hunk, then accept to a new local branch. Your checkout stays exactly as you left it.</p>
        </div>
        <div class="feat-vis vis-changes" aria-hidden="true">
          <div class="ch-h"><span>Changes</span><span class="mono">3 files</span></div>
          <div class="ch-f"><span class="mono">src/net.mjs</span><span class="mono"><b class="plus">+5</b> <b class="minus">-2</b></span><span class="ch-k ch-k1">Accepted</span></div>
          <div class="ch-f"><span class="mono">src/tax.mjs</span><span class="mono"><b class="plus">+3</b> <b class="minus">-1</b></span><span class="ch-k ch-k2">Accepted</span></div>
          <div class="ch-f"><span class="mono">test/net.test.mjs</span><span class="mono"><b class="plus">+18</b></span><span class="ch-k ch-k3">Accepted</span></div>
          <div class="ch-b"><span class="mono"><Icon name="branch" size={14} />fix-rounding</span><span class="ch-btn">Accept to branch</span></div>
        </div>
      </div>

      <div class="feat feat-rev reveal">
        <div class="feat-copy">
          <span class="feat-n mono">04</span>
          <h3>You approve what runs</h3>
          <p>Commands, edits and tool calls ask first unless you allow them. When a provider starts subagents, each one shows live under the step that started it, so nothing runs out of sight.</p>
        </div>
        <div class="feat-vis vis-perm" aria-hidden="true">
          <div class="pc">
            <div class="pc-q"><Icon name="shield" size={16} />Run the tests in the scratch copy?</div>
            <div class="pc-cmd mono">node --test</div>
            <div class="pc-a"><span class="pb pb-1">Allow once</span><span class="pb">Allow for this thread</span><span class="pb pb-deny">Deny</span></div>
          </div>
          <div class="sp">
            <div class="sp-h"><Icon name="branch" size={14} /><span>Task: find every caller</span><span class="sp-b mono">3 subagents</span></div>
            <div class="sp-r" style="--i:0"><Icon name="check" size={13} />Subagent 1 <code>src/cart.mjs</code></div>
            <div class="sp-r" style="--i:1"><Icon name="check" size={13} />Subagent 2 <code>src/checkout.mjs</code></div>
            <div class="sp-r" style="--i:2"><Icon name="check" size={13} />Subagent 3 <code>test/</code></div>
          </div>
        </div>
      </div>

      <div class="feat reveal">
        <div class="feat-copy">
          <span class="feat-n mono">05</span>
          <h3>Split big jobs across providers</h3>
          <p>An orchestrator breaks a large request into up to 8 slices, and each slice goes to the provider with room for it. A second model reviews the work before you see it.</p>
        </div>
        <div class="feat-vis vis-plan" aria-hidden="true">
          <div class="plan-h"><Kite size={14} /><span>Plan</span><span class="mono plan-c">4 slices</span></div>
          <div class="slice" style="--i:0"><span class="s-t">Map the rounding paths</span><span class="s-d">Easy</span><span class="fam fam-l">L</span><span class="s-s"><em>Done</em></span></div>
          <div class="slice" style="--i:1"><span class="s-t">Clamp netMinor at zero</span><span class="s-d">Medium</span><span class="fam fam-a">A</span><span class="s-s"><em>Done</em></span></div>
          <div class="slice" style="--i:2"><span class="s-t">Fix the tax rounding</span><span class="s-d">Hard</span><span class="fam fam-o">O</span><span class="s-s"><em>Done</em></span></div>
          <div class="slice" style="--i:3"><span class="s-t">Add tests for the edges</span><span class="s-d">Easy</span><span class="fam fam-g">G</span><span class="s-s"><em>Done</em></span></div>
          <div class="plan-f mono">Crew finished: 4 slices, 4 reviews, 1 fix.</div>
        </div>
      </div>

      <div class="more-feats">
        <article class="mf reveal">
          <h3>Use the plans you already pay for</h3>
          <p>CrewKite drives each provider's own signed-in app. No API keys, no extra subscription, no per-token bill. New models show up the day your provider serves them.</p>
        </article>
        <article class="mf reveal" style="--d:70ms">
          <h3>Bring a local model</h3>
          <p>Connect LM Studio and it takes the small slices that fit, free, on your own hardware.</p>
        </article>
        <article class="mf reveal" style="--d:140ms">
          <h3>Built for big repositories</h3>
          <p>No file count cap. CrewKite checks free disk space before it copies, and history search covers every thread.</p>
        </article>
        <article class="mf reveal" style="--d:210ms">
          <h3>Your work stays on your computer</h3>
          <p>No account, no telemetry, nothing hosted. Apache 2.0, so you can read every line.</p>
        </article>
      </div>
      <ul class="chips reveal" aria-label="Also in this version">
        <li>History search</li>
        <li>Project notes</li>
        <li>Usage analytics with CSV</li>
        <li>Share page</li>
        <li>Markdown export</li>
        <li>Diagnostics export</li>
      </ul>
    </div>
  </section>

  <!-- Why I built it -->
  <section id="why-built" class="built" aria-labelledby="built-h">
    <div class="wrap">
      <div class="built-col reveal">
        <h2 id="built-h" class="built-h">Why I built it</h2>
        <p>I build products for underserved niche markets, and I start each one by talking with the people who have the problem. Along the way I kept running into problems in my own workflow that no tool solved.</p>
        <p>I work across several AI subscriptions and a local model, because each one is strongest at something different: backend work, frontend and design, or catching defects in review. Using them together on one repository meant separate apps and terminals, watching every usage meter, and writing handoffs by hand. Each new agent reread the whole context, and the style of the work drifted with every switch.</p>
        <p>CrewKite is the controller I wanted: every provider in one thread, held to how I want my work done. Its review methods draw on open-source projects like multi, ADHD and Ponytail, <a href="https://github.com/rjk6831/crewkite/blob/main/docs/credits.md">credited in the docs</a>, so you get those ideas without having to find them first.</p>
        <p>CrewKite is free and open source. Other people's open-source work has helped me a great deal, and this is my turn to give back. I am measuring efficiency with a benchmark now, and I will not claim gains until the numbers are in. Until then, what I want most is your feedback. My best product decisions have come from real people telling me what they need. Try it, and tell me where it falls short.</p>
        <p class="built-sig">Raymond J. Kraft</p>
      </div>
    </div>
  </section>

  <!-- Safety -->
  <section id="safety" aria-labelledby="safe-h">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Safety</span>
        <h2 id="safe-h" class="h2">Safe with your repository and your accounts</h2>
      </div>
      <div class="safe">
        <article class="scard reveal"><Icon name="branch" size={22} /><h3>Your checkout is never written</h3><p>Models work in a scratch copy. Results land as new local branches, and only when you accept them.</p></article>
        <article class="scard reveal" style="--d:70ms"><Icon name="eye" size={22} /><h3>Nothing leaves your machine except what your provider client sends</h3><p>No telemetry, no account, no server of its own.</p></article>
        <article class="scard reveal" style="--d:140ms"><Icon name="key" size={22} /><h3>Secrets are redacted</h3><p>Tool output, exports and diagnostics go through redaction before they are shown or saved.</p></article>
        <article class="scard reveal" style="--d:210ms"><Icon name="lock" size={22} /><h3>Each vendor's own client runs with your own sign-in</h3><p>CrewKite never reads or stores a provider credential and never falls back to paid API billing.</p></article>
      </div>
      <p class="reveal more"><a class="arrow-link" href="/safety">How CrewKite handles authority <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- Terminal -->
  <section id="terminal" aria-labelledby="term-h">
    <div class="wrap term-grid">
      <div class="reveal">
        <span class="eyebrow">Terminal too</span>
        <h2 id="term-h" class="h2">The same threads in your terminal</h2>
        <p class="lede">The CLI talks to the same controller as the desktop. Start a thread in one and pick it up in the other. Slash commands, file mentions and <code>crewkite -p</code> for scripts.</p>
        <div class="cmd term-cmd"><code>pnpm crewkite</code><button class="copy" type="button" data-copy="pnpm crewkite" hidden><Icon name="copy" size={13} />Copy</button></div>
        <p class="small">From a source checkout. <a href={`${BLOB}/apps/cli/README.md`}>The CLI guide</a> lists every key and command.</p>
      </div>
      <div class="reveal">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section id="open" aria-labelledby="open-h">
    <div class="wrap">
      <div class="os reveal">
        <div class="os-copy">
          <span class="eyebrow">Open source</span>
          <h2 id="open-h" class="h2">Apache 2.0, built in the open</h2>
          <p class="lede">Prerelease. I build CrewKite in the open and ship it as it gets better. Every decision has an architecture decision record, and an extension seam lets separately licensed modules plug in.</p>
          <div class="os-links">
            <a class="arrow-link" href={REPO}>Source <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/CONTRIBUTING.md`}>Contributing <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/docs/adr/README.md`}>Decision records <Icon name="arrow" size={16} /></a>
            <a class="arrow-link" href={`${BLOB}/docs/extensions.md`}>Extension seam <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <dl class="os-stats">
          <div><dt>License</dt><dd>Apache 2.0</dd></div>
          <div><dt>Version</dt><dd class="mono" data-release="version">{VERSION_FALLBACK}</dd></div>
          <div data-stars-row hidden><dt>GitHub stars</dt><dd class="mono" data-stars-plain></dd></div>
          <div><dt>Telemetry</dt><dd>None</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div class="reveal">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-h" class="h2">Questions</h2>
        <p class="lede">The rest is in the <a href="/docs">docs</a>.</p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="reveal" id={f.id}>
            <summary><span>{f.q}</span><Icon name="plus" size={18} /></summary>
            <div class="faq-a" set:html={f.a} />
          </details>
        ))}
        <details class="reveal">
          <summary><span>How do I reach you?</span><Icon name="plus" size={18} /></summary>
          <div class="faq-a">
            <p>Email me at <Email />. Open an issue on <a href={`${REPO}/issues`}>GitHub</a> for bugs and requests. Report a security issue privately through GitHub as <a href={`${BLOB}/SECURITY.md`}>SECURITY.md</a> describes, never by email or in a public issue.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final call -->
  <section class="final" aria-labelledby="final-h">
    <div class="wrap">
      <div class="final-box reveal">
        <Kite size={56} class="final-kite" />
        <h2 id="final-h" class="h2">Download CrewKite <span data-release="version">{VERSION_FALLBACK}</span></h2>
        <p class="lede">macOS on Apple silicon. Linux x64 and arm64 preview. Windows is not supported yet.</p>
        <div class="hero-cta">
          <Download variant="final" />
          <a class="btn btn-ghost" href={REPO}><Icon name="code" />View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: 72px 0 40px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: -10% 0 auto;
    height: 900px;
    background:
      radial-gradient(ellipse 50% 40% at 50% 30%, var(--glow), transparent 70%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 25%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 25%, #000 20%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color 160ms;
  }
  .pill:hover { border-color: var(--accent); color: var(--text); }
  .pill-tag {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    font-size: 12px;
  }
  h1 {
    margin-top: 28px;
    max-width: 20ch;
    font-size: clamp(34px, 5.6vw, 66px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 650;
  }
  .n-o { color: var(--openai); }
  .n-a { color: var(--anthropic); }
  .n-g { color: var(--google); }
  .n-l { color: var(--local); }
  .fchips {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    width: 100%;
    max-width: 640px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .fchip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-weight: 550;
    font-size: 15px;
    overflow: hidden;
    cursor: default;
    user-select: none;
  }
  .fchip::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--c);
    transform: scaleX(0.3);
    opacity: 0.8;
    transition: transform 300ms var(--ease);
  }

  .fchip .fam { width: 22px; height: 22px; font-size: 11px; border-radius: 6px; }
  .fchip-o { --c: var(--openai-fill); }
  .fchip-a { --c: var(--anthropic-fill); }
  .fchip-g { --c: var(--google-fill); }
  .fchip-l { --c: var(--local-fill); }
  .inf { color: var(--local); font-size: 17px; line-height: 1; }
  .js .in .fchip::after { animation: chip 1s var(--ease) both; animation-delay: calc(var(--k, 0) * 120ms + 300ms); }
  .fchip-a { --k: 1; }
  .fchip-g { --k: 2; }
  .fchip-l { --k: 3; }
  @keyframes chip { from { transform: scaleX(0); } }
  .hero-sub {
    margin-top: 22px;
    max-width: 64ch;
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--text-muted);
  }
  .hero-cta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .hero-meta {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    font-size: 13px;
    color: var(--text-dim);
  }
  .hero-meta a { color: var(--text-muted); text-underline-offset: 3px; }
  .hero-shot {
    margin-top: 64px;
    width: 100%;
    max-width: 1080px;
    perspective: 1600px;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-shot :global(.replay) {
        animation: tilt linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
        transform-origin: 50% 0;
      }
      @keyframes tilt {
        from { transform: rotateX(16deg) scale(0.94); opacity: 0.6; }
        to { transform: none; opacity: 1; }
      }
    }
  }
  .js .hero .reveal { transition-delay: calc(var(--i, 0) * 60ms); }

  /* Providers */
  .fams {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .fcard {
    position: relative;
    padding: 22px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
    transition-delay: var(--d, 0ms);
    transition-property: opacity, transform, border-color;
  }
  .fcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--c);
  }
  .fcard::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px 160px at 50% -40px, color-mix(in srgb, var(--c) 16%, transparent), transparent);
    opacity: 0;
    transition: opacity 300ms;
    pointer-events: none;
  }
  .fcard:hover { border-color: color-mix(in srgb, var(--c) 50%, var(--border)); }
  .fcard:hover::after { opacity: 1; }
  .fcard-o { --c: var(--openai-fill); }
  .fcard-a { --c: var(--anthropic-fill); }
  .fcard-g { --c: var(--google-fill); }
  .fcard-l { --c: var(--local-fill); }
  .fcard-top { display: flex; align-items: center; gap: 10px; }
  .fcard-top .fam { width: 24px; height: 24px; font-size: 12px; border-radius: 7px; }
  .fcard h3 { font-size: 20px; }
  .fcard-client { font-weight: 500; font-size: 15px; }
  .fcard-plan { font-size: 14px; color: var(--text-muted); }
  .fcard-note {
    margin-top: auto;
    font-size: 13px;
    color: var(--text-muted);
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
  }
  .fcard-note a { color: var(--text); font-weight: 600; text-underline-offset: 3px; }
  .fams-note {
    margin-top: 24px;
    font-size: 15px;
    color: var(--text-muted);
    text-align: center;
  }

  /* Features */
  /* Each benefit is one text-and-demo pair. Named areas keep it at two cells at every width. */
  .feat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    grid-template-areas: 'copy vis';
    gap: 64px;
    align-items: center;
    padding: 40px 0;
  }
  .feat-rev {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas: 'vis copy';
  }
  .feat-copy { grid-area: copy; }
  .feat-vis { grid-area: vis; }
  .feat + .feat { border-top: 1px solid var(--border); }
  .feat-n { color: var(--accent); font-size: 13px; }
  .feat h3 { margin-top: 10px; font-size: clamp(22px, 2.6vw, 30px); }
  .feat p { margin-top: 14px; color: var(--text-muted); max-width: 52ch; }
  .chips {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    font-size: 12.5px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
  }
  .feat-vis {
    position: relative;
    min-height: 300px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background:
      radial-gradient(500px 220px at 70% 0%, var(--glow), transparent),
      var(--sidebar);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    font-size: 13.5px;
    overflow: hidden;
  }

  /* 01 handoff */
  .ht {
    display: grid;
    gap: 7px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .ht-h { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-muted); margin-bottom: 2px; }
  .ht-h .fam { width: 16px; height: 16px; font-size: 9px; }
  .ht b { height: 7px; border-radius: 4px; background: var(--border-strong); }
  .ht b:nth-of-type(1) { width: 85%; }
  .ht b:nth-of-type(2) { width: 62%; }
  .ht b:nth-of-type(3) { width: 74%; }
  .ht-lim { margin-left: auto; font-size: 11.5px; color: var(--red); }
  .ht-carry { margin-left: auto; display: flex; gap: 6px; }
  .ht-carry span { font-size: 11px; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--text-muted); }
  .ht-o b { background: var(--border); }
  .ht-a { border-color: color-mix(in srgb, var(--anthropic) 45%, var(--border)); }
  .hand-line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-muted);
    text-align: center;
  }
  .hand-line::before,
  .hand-line::after {
    content: '';
    flex: 1;
    height: 1px;
    min-width: 12px;
    background: linear-gradient(90deg, var(--openai), var(--anthropic));
  }
  .hand-mode { display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; color: var(--text-dim); }
  .hand-mode b { font-weight: 500; color: var(--text); }
  @media (prefers-reduced-motion: no-preference) {
    .js .vis-hand .hand-line, .js .vis-hand .ht-a, .js .vis-hand .ht-carry span { opacity: 0; transform: translateY(6px); transition: all 500ms var(--ease); }
    .js .in .vis-hand .hand-line { opacity: 1; transform: none; transition-delay: 500ms; }
    .js .in .vis-hand .ht-a { opacity: 1; transform: none; transition-delay: 900ms; }
    .js .in .vis-hand .ht-carry span { opacity: 1; transform: none; transition-delay: 1300ms; }
    .js .in .vis-hand .ht-carry span + span { transition-delay: 1500ms; }
  }

  /* 02 allowances */
  .vis-allow { gap: 14px; }
  .al { display: grid; gap: 6px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); }
  .al-h { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .al-h .fam { width: 16px; height: 16px; font-size: 9px; }
  .al-h span:last-child { margin-left: auto; font-size: 11.5px; color: var(--text-dim); }
  .al-r { display: flex; align-items: center; gap: 10px; font-size: 12px; }
  .al-r > span { min-width: 76px; text-align: right; font-variant-numeric: tabular-nums; color: var(--text-muted); }
  .al-r i { flex: 1; height: 5px; border-radius: 3px; background: var(--border); overflow: hidden; }
  .al-r em { display: block; height: 100%; width: calc(var(--v) * 1%); background: var(--c); border-radius: 3px; }
  .al-inf b { color: var(--local); font-weight: 400; font-size: 15px; line-height: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .js .vis-allow .al-r em { transform: scaleX(0); transform-origin: left; transition: transform 1100ms var(--ease); }
    .js .in .vis-allow .al-r em { transform: none; }
    .js .in .vis-allow .al:nth-child(2) em { transition-delay: 120ms; }
    .js .in .vis-allow .al:nth-child(3) em { transition-delay: 240ms; }
    .js .in .vis-allow .al:nth-child(4) em { transition-delay: 360ms; }
  }

  /* 02 plan */
  .plan-h { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .plan-c { margin-left: auto; color: var(--text-dim); font-weight: 400; font-size: 12px; }
  .slice {
    display: grid;
    grid-template-columns: 1fr auto 20px 70px;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .s-t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .s-d { font-size: 12px; color: var(--text-dim); }
  .s-s { text-align: right; font-size: 12px; }
  .s-s em { font-style: normal; color: var(--green); }
  .plan-f { font-size: 12px; color: var(--text-muted); padding-top: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .js .vis-plan .s-s em { font-size: 0; color: var(--text-dim); }
    .js .vis-plan .s-s em::before { content: 'Queued'; font-size: 12px; }
    .js .in .vis-plan .s-s em,
    .js .in .vis-plan .s-s em::before { animation: slice 2.4s steps(1) forwards; animation-delay: calc(300ms + var(--i) * 450ms); }
    .js .in .vis-plan .s-s em::before { animation-name: slice-t; }
  }
  @keyframes slice {
    0% { color: var(--blue); }
    60%, 100% { color: var(--green); }
  }
  @keyframes slice-t {
    0% { content: 'Running'; }
    60%, 100% { content: 'Done'; }
  }
  .js .vis-plan .plan-f { opacity: 0; transition: opacity 400ms 4000ms; }
  .js .in .vis-plan .plan-f { opacity: 1; }

  /* 03 permission */
  .vis-perm { align-items: center; }
  .pc {
    width: 100%;
    max-width: 440px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--amber);
    background: var(--surface);
    display: grid;
    gap: 12px;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--amber) 8%, transparent);
  }
  .pc-q { display: flex; gap: 8px; align-items: center; font-weight: 500; }
  .pc-q :global(svg) { color: var(--amber); flex: none; }
  .pc-cmd {
    padding: 8px 10px;
    border-radius: 7px;
    background: var(--diff-add);
    color: var(--green);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pc-a { display: flex; flex-wrap: wrap; gap: 8px; }
  .pb {
    height: 30px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    font-size: 13px;
    font-weight: 500;
  }
  .pb-1 { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .pb-deny { color: var(--red); }
  .js .in .vis-perm .pb-1 { animation: press 2.8s var(--ease) 1.2s infinite; }
  @keyframes press {
    0%, 70%, 100% { box-shadow: 0 0 0 0 var(--accent-soft); transform: none; }
    80% { box-shadow: 0 0 0 7px var(--accent-soft); transform: scale(0.96); }
  }
  .pc-lock { display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: 12.5px; }

  /* 04 changes */
  .ch-h { display: flex; justify-content: space-between; font-weight: 600; }
  .ch-h .mono { color: var(--text-dim); font-weight: 400; font-size: 12px; }
  .ch-f {
    display: grid;
    grid-template-columns: 1fr auto 82px;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 12.5px;
  }
  .ch-f > span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ch-k {
    justify-self: end;
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 6px;
    color: var(--green);
    background: color-mix(in srgb, var(--green) 12%, transparent);
  }
  .js .vis-changes .ch-k { opacity: 0; transform: scale(0.8); transition: all 300ms var(--ease); }
  .js .in .vis-changes .ch-k1 { opacity: 1; transform: none; transition-delay: 500ms; }
  .js .in .vis-changes .ch-k2 { opacity: 1; transform: none; transition-delay: 900ms; }
  .js .in .vis-changes .ch-k3 { opacity: 1; transform: none; transition-delay: 1300ms; }
  .ch-b {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 4px;
  }
  .ch-b .mono { display: inline-flex; gap: 6px; align-items: center; color: var(--text-muted); font-size: 12.5px; }
  .ch-btn {
    height: 32px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 13px;
  }
  .js .in .vis-changes .ch-btn { animation: press 2.8s var(--ease) 1.8s infinite; }

  /* 05 approvals and subagents */
  .vis-perm { align-items: stretch; }
  .sp { border-radius: 12px; border: 1px solid var(--border); background: var(--surface); overflow: hidden; }
  .sp-h { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-bottom: 1px solid var(--border); font-size: 13px; }
  .sp-h :global(svg) { color: var(--text-dim); }
  .sp-b { margin-left: auto; font-size: 11px; padding: 3px 8px; border-radius: 999px; background: color-mix(in srgb, var(--anthropic) 14%, transparent); color: var(--anthropic); }
  .sp-r { display: flex; align-items: center; gap: 8px; padding: 6px 12px; font-size: 12.5px; }
  .sp-r + .sp-r { border-top: 1px solid var(--border); }
  .sp-r :global(svg) { color: var(--green); }
  .sp-r code { color: var(--text-muted); font-size: 12px; }
  @media (prefers-reduced-motion: no-preference) {
    .js .vis-perm .sp-r { opacity: 0; transition: opacity 400ms var(--ease); transition-delay: calc(600ms + var(--i) * 350ms); }
    .js .in .vis-perm .sp-r { opacity: 1; }
  }

  .more-feats {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .mf {
    padding: 24px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition-delay: var(--d, 0ms);
  }
  .mf-n { color: var(--accent); font-size: 13px; }
  .mf h3 { margin-top: 10px; font-size: 18px; line-height: 1.25; }
  .mf p { margin-top: 10px; color: var(--text-muted); font-size: 14.5px; }
  #adds .chips { justify-content: center; margin-top: 28px; }

  /* Why I built it */
  /* About 65 characters per line in Inter at 16 px; ch is the width of a zero, wider than the average letter. */
  .built-col {
    max-width: 49ch;
    text-align: left;
  }
  .built-h {
    font-size: clamp(26px, 3vw, 32px);
    margin-bottom: 20px;
  }
  .built-col p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }
  .built-col p + p { margin-top: 16px; }
  .built-col a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }
  .built-col .built-sig {
    margin-top: 24px;
    font-weight: 300;
    color: var(--text-muted);
  }

  /* Safety */
  .safe {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .scard {
    padding: 28px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition-delay: var(--d, 0ms);
  }
  .scard :global(svg) { color: var(--accent); }
  .scard h3 { margin-top: 18px; font-size: 19px; line-height: 1.3; }
  .scard p { margin-top: 8px; color: var(--text-muted); font-size: 15px; }
  .more { margin-top: 28px; }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .arrow-link :global(svg) { transition: transform 160ms var(--ease); }
  .arrow-link:hover :global(svg) { transform: translateX(3px); }

  /* Terminal */
  .term-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 56px;
    align-items: center;
  }
  .term-grid > *, .feat > *, .faq-grid > *, .os > * { min-width: 0; }
  .term-cmd { margin-top: 28px; max-width: 360px; }
  .small { margin-top: 12px; font-size: 14px; color: var(--text-dim); }
  .small a { color: var(--text-muted); }
  .lede code { color: var(--text); }

  /* Open source */
  .os {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    padding: 48px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background:
      radial-gradient(600px 300px at 0% 0%, var(--glow), transparent),
      var(--surface);
  }
  .os-links { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 14px 28px; }
  .os-stats {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border-radius: 12px;
    overflow: hidden;
    align-self: center;
  }
  .os-stats > div { background: var(--surface-raised); padding: 20px; }
  .os-stats dt { font-size: 12px; color: var(--text-dim); font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.06em; }
  .os-stats dd { margin: 6px 0 0; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 56px; align-items: start; }
  .faq { border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 4px;
    font-size: 17px;
    font-weight: 550;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(svg) { color: var(--text-dim); transition: transform 220ms var(--ease); flex: none; }
  .faq details[open] summary :global(svg) { transform: rotate(45deg); color: var(--accent); }
  .faq summary:hover span { color: var(--accent); }
  .faq-a { padding: 0 4px 22px; color: var(--text-muted); max-width: 68ch; }
  .faq-a :global(a) { color: var(--text); text-underline-offset: 3px; }
  .faq details::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 280ms var(--ease), content-visibility 280ms allow-discrete;
  }
  .faq details[open]::details-content { block-size: auto; }
  :global(html) { interpolate-size: allow-keywords; }

  /* Final */
  .final-box {
    position: relative;
    text-align: center;
