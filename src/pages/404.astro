---
import Base from '../layouts/Base.astro';
import Kite from '../components/Kite.astro';
---
<Base title="Page not found: CrewKite" path="/404">
  <section class="nf">
    <div class="wrap">
      <span class="nf-kite"><Kite size={64} tail /></span>
      <h1>This page drifted off.</h1>
      <p class="lede">The link may be old. The home page and the download page are one click away.</p>
      <p class="nf-a"><a class="btn btn-primary" href="/">Head back home</a><a class="btn btn-ghost" href="/download">Download</a></p>
    </div>
  </section>
</Base>
<style>
  .nf { padding: var(--space-32) 0; text-align: center; }
  .nf .wrap { display: flex; flex-direction: column; align-items: center; }
  .nf h1 { margin-top: var(--space-8); font-size: var(--text-h2); }
  /* The kite rests a little off-center and tilted. With motion allowed it drifts there once. */
  .nf-kite { display: inline-block; line-height: 0; transform: translateX(26px) rotate(-14deg); }
  @media (prefers-reduced-motion: no-preference) {
    .nf-kite { animation: nf-drift 1400ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  }
  @keyframes nf-drift {
    from { transform: translate(-18px, 22px) rotate(6deg); opacity: 0; }
    to { transform: translateX(26px) rotate(-14deg); opacity: 1; }
  }
  .nf .lede { margin-left: auto; margin-right: auto; }
  .nf-a { margin-top: var(--space-8); display: flex; gap: var(--space-3); }
</style>
