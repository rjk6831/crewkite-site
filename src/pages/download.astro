---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Kite from '../components/Kite.astro';
import { REPO, BLOB, ASSETS, url, DL, VERSION_FALLBACK } from '../data/site.js';

const linux = [
  { fmt: 'AppImage', x64: ASSETS.appimageX64, arm: ASSETS.appimageArm, x64cmd: `chmod +x ${ASSETS.appimageX64} && ./${ASSETS.appimageX64}`, armcmd: `chmod +x ${ASSETS.appimageArm} && ./${ASSETS.appimageArm}`, note: 'Any distribution with FUSE' },
  { fmt: '.deb', x64: ASSETS.debX64, arm: ASSETS.debArm, x64cmd: `sudo apt install ./${ASSETS.debX64}`, armcmd: `sudo apt install ./${ASSETS.debArm}`, note: 'Debian, Ubuntu and derivatives' },
  { fmt: '.rpm', x64: ASSETS.rpmX64, arm: ASSETS.rpmArm, x64cmd: `sudo dnf install ./${ASSETS.rpmX64}`, armcmd: `sudo dnf install ./${ASSETS.rpmArm}`, note: 'Fedora, RHEL and derivatives' },
];
---
<Base title="Download CrewKite" description="Download CrewKite for macOS on Apple silicon or the Linux preview for x64 and arm64, with SHA-256 checksums." path="/download">
  <section class="dl-hero">
    <div class="wrap">
      <span class="eyebrow">Download</span>
      <h1 class="dl-h">CrewKite <span data-release="version">{VERSION_FALLBACK}</span></h1>
      <p class="lede">Each build comes from the latest GitHub release, with a SHA-256 checksum beside it. Each provider still needs its own client, signed in on your computer.</p>
      <p class="dl-meta mono">
        <span data-release="date-line" hidden></span>
        <a href="/changelog">Release notes</a>
        <a href={`${REPO}/releases`}>All releases</a>
      </p>
      <nav class="jump" aria-label="Platforms">
        <a href="#macos">macOS</a><a href="#linux">Linux</a><a href="#windows">Windows</a><a href="#verify">Verify</a><a href="#matrix">Platform matrix</a>
      </nav>
    </div>
  </section>

  <section id="macos" class="plat">
    <div class="wrap plat-grid">
      <div>
        <h2 class="plat-h">macOS</h2>
        <p class="plat-sub">macOS on Apple silicon. The release notes give the tested minimum version. Intel Macs are not built.</p>
        <div class="dl-row">
          <a class="btn btn-primary" href={url(ASSETS.mac)}><Icon name="download" />Download .dmg</a>
          <span class="asset-meta mono"><span data-size={ASSETS.mac}></span><span data-signing></span></span>
        </div>
        <div class="sha" data-sha-row={ASSETS.mac} hidden>
          <span class="sha-l">SHA-256</span><code data-sha={ASSETS.mac}></code>
          <button class="copy" type="button" data-copy-sha={ASSETS.mac} hidden><Icon name="copy" size={13} /><span data-label>Copy</span></button>
        </div>
      </div>
      <ol class="steps">
        <li><b>Open</b> the .dmg you downloaded.</li>
        <li><b>Drag</b> CrewKite into Applications.</li>
        <li><b>Launch</b> CrewKite from Applications, then connect a provider in Settings.</li>
      </ol>
    </div>
  </section>

  <section id="linux" class="plat">
    <div class="wrap">
      <h2 class="plat-h">Linux preview</h2>
      <p class="plat-sub">x64 and arm64. OpenAI, Anthropic and Local run on Linux. Google is not on Linux yet.</p>
      <div class="ltable" role="table" aria-label="Linux builds">
        {linux.map((r) => (
          <div class="lrow" role="row">
            <div class="lfmt" role="cell"><b>{r.fmt}</b><span>{r.note}</span></div>
            {[['x64', r.x64, r.x64cmd], ['arm64', r.arm, r.armcmd]].map(([arch, file, cmd]) => (
              <div class="lcell" role="cell">
                <div class="lcell-top">
                  <a class="btn btn-ghost btn-sm" href={url(file)}><Icon name="download" size={16} />{arch}</a>
                  <span class="asset-meta mono" data-size={file}></span>
                </div>
                <div class="cmd"><code>{cmd}</code><button class="copy" type="button" data-copy={cmd} hidden><Icon name="copy" size={13} /><span data-label>Copy</span></button></div>
                <div class="sha sha-sm" data-sha-row={file} hidden><span class="sha-l">SHA-256</span><code data-sha={file}></code></div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="windows" class="plat">
    <div class="wrap">
      <h2 class="plat-h">Windows</h2>
      <p class="plat-sub win-note">Not supported yet. WSL2 is untested.</p>
    </div>
  </section>

  <section id="verify" class="plat">
    <div class="wrap plat-grid">
      <div>
        <h2 class="plat-h">Verify the download</h2>
        <p class="plat-sub">Download <a href={`${DL}/SHA256SUMS`}>SHA256SUMS</a> into the same folder, then check the file before you open it.</p>
      </div>
      <div class="verify">
        <p class="v-l">macOS</p>
        <div class="cmd"><code>shasum -a 256 -c SHA256SUMS --ignore-missing</code><button class="copy" type="button" data-copy="shasum -a 256 -c SHA256SUMS --ignore-missing" hidden><Icon name="copy" size={13} /><span data-label>Copy</span></button></div>
        <p class="v-l">Linux</p>
        <div class="cmd"><code>sha256sum -c SHA256SUMS --ignore-missing</code><button class="copy" type="button" data-copy="sha256sum -c SHA256SUMS --ignore-missing" hidden><Icon name="copy" size={13} /><span data-label>Copy</span></button></div>
      </div>
    </div>
  </section>

  <section id="matrix" class="plat">
    <div class="wrap">
      <h2 class="plat-h">Platform matrix</h2>
      <div class="mtx-wrap">
        <table class="mtx">
          <thead>
            <tr><th scope="col">Platform</th><th scope="col">Build</th><th scope="col"><span class="fam fam-o">O</span> OpenAI</th><th scope="col"><span class="fam fam-a">A</span> Anthropic</th><th scope="col"><span class="fam fam-g">G</span> Google</th><th scope="col"><span class="fam fam-l">L</span> Local</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">macOS, Apple silicon</th><td>.dmg</td><td class="y">Yes</td><td class="y">Yes</td><td class="y">Yes</td><td class="y">Yes</td></tr>
            <tr><th scope="row">Linux x64 and arm64 (preview)</th><td>AppImage, .deb, .rpm</td><td class="y">Yes</td><td class="y">Yes</td><td class="n">Not yet</td><td class="y">Yes</td></tr>
            <tr><th scope="row">Windows</th><td>Not supported yet</td><td class="n">No</td><td class="n">No</td><td class="n">No</td><td class="n">No</td></tr>
            <tr><th scope="row">macOS Intel</th><td>Not built</td><td class="n">No</td><td class="n">No</td><td class="n">No</td><td class="n">No</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="plat">
    <div class="wrap plat-grid">
      <div>
        <h2 class="plat-h">Provider clients</h2>
        <p class="plat-sub">CrewKite accepts a range of client builds within the major version I tested. Settings names the version it found. <a href={`${BLOB}/docs/providers.md#client-versions`}>Provider routes</a> has the setup for each.</p>
      </div>
      <dl class="clients">
        <div><dt><span class="fam fam-o">O</span>OpenAI</dt><dd>From 0.163.0, tested with 0.163.0</dd></div>
        <div><dt><span class="fam fam-a">A</span>Anthropic</dt><dd>From 2.1.0, tested with 2.1.302</dd></div>
        <div><dt><span class="fam fam-g">G</span>Google quota reader</dt><dd>From 1.4.0, tested with 1.4.2</dd></div>
        <div><dt><span class="fam fam-l">L</span>Local</dt><dd>LM Studio with one loaded model</dd></div>
      </dl>
    </div>
  </section>

  <section class="plat last">
    <div class="wrap">
      <p class="plat-sub"><a href={`${BLOB}/docs/preview.md#uninstall`}>Uninstall steps</a> list every folder CrewKite writes. If a download fails, use <a href={`${REPO}/releases/latest`}>GitHub Releases</a> directly.</p>
    </div>
  </section>
</Base>

<style>
  .dl-hero { padding: 72px 0 24px; }
  .dl-h { margin-top: 14px; font-size: clamp(36px, 6vw, 60px); letter-spacing: -0.035em; }
  .dl-meta { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 13px; color: var(--text-dim); }
  .dl-meta a { color: var(--text-muted); }
  .jump { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a {
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 14px;
    text-decoration: none;
    color: var(--text-muted);
  }
  .jump a:hover { color: var(--text); border-color: var(--border-strong); }
  .plat { padding: 48px 0; border-top: 1px solid var(--border); }
  .plat:target, .plat:has(:target) { background: linear-gradient(var(--accent-soft), transparent 60%); }
  .plat.last { border-top: 0; padding-top: 8px; }
  .plat-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: start; }
  .plat-h { font-size: 28px; }
  .plat-sub { margin-top: 10px; color: var(--text-muted); max-width: 62ch; }
  .plat-sub a { color: var(--text); }
  .win-note { font-size: 18px; }
  .dl-row { margin-top: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .asset-meta { display: inline-flex; gap: 12px; font-size: 12.5px; color: var(--text-dim); }
  .sha {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 8px 8px 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--sidebar);
  }
  .sha code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; color: var(--text-muted); }
  .sha-l { font: 500 11px/1 var(--mono); color: var(--text-dim); flex: none; }
  .sha-sm { margin-top: 8px; padding: 6px 10px; }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 10px; }
  .steps li {
    counter-increment: s;
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
  }
  .steps li::before { content: counter(s); font: 600 13px/1 var(--mono); color: var(--accent); }
  .steps b { color: var(--text); font-weight: 600; }
  .ltable { margin-top: 24px; display: grid; gap: 12px; }
  .lrow {
    display: grid;
    grid-template-columns: 200px 1fr 1fr;
    gap: 16px;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .lfmt { display: grid; align-content: start; gap: 4px; }
  .lfmt b { font-size: 17px; }
  .lfmt span { font-size: 13px; color: var(--text-dim); }
  .lcell { min-width: 0; display: grid; gap: 8px; }
  .lcell-top { display: flex; align-items: center; gap: 10px; }
  .lcell .cmd code { font-size: 12px; }
  .verify { display: grid; gap: 8px; }
  .v-l { font: 500 12px/1 var(--mono); color: var(--text-dim); margin-top: 6px; }
  .mtx-wrap { margin-top: 24px; overflow-x: auto; border-radius: 12px; border: 1px solid var(--border); }
  .mtx { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 680px; }
  .mtx th, .mtx td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--border); }
  .mtx thead th { font-weight: 500; color: var(--text-muted); background: var(--surface-raised); white-space: nowrap; }
  .mtx thead .fam { width: 16px; height: 16px; font-size: 9px; vertical-align: -3px; margin-right: 4px; }
  .mtx tbody th { font-weight: 500; }
  .mtx tr:last-child > * { border-bottom: 0; }
  .mtx .y { color: var(--green); }
  .mtx .n { color: var(--text-dim); }
  .clients { margin: 0; display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .clients > div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 16px; background: var(--surface); font-size: 14px; }
  .clients dt { display: flex; align-items: center; gap: 8px; font-weight: 500; }
  .clients dd { margin: 0; color: var(--text-muted); text-align: right; }
  @media (max-width: 900px) {
    .plat-grid { grid-template-columns: 1fr; gap: 24px; }
    .lrow { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .clients > div { flex-direction: column; gap: 4px; }
    .clients dd { text-align: left; }
  }
</style>
