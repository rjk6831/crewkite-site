---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { REPO, BLOB } from '../data/site.js';

const parts = [
  {
    icon: 'shield', h: 'Authority stays in code',
    p: ['One controller decides what runs. A model can propose a plan. Permissions come only from you or from the policy you set. A prompt or a reply that asks for more is just text.'],
    link: [`${BLOB}/docs/architecture.md`, 'Architecture'],
  },
  {
    icon: 'branch', h: 'Scratch copies and branches',
    p: ['Each thread works in a scratch copy of your repository. Your checkout, your Git metadata and your remotes stay untouched while models work.', 'Changes compares the copy with the base commit. Accept commits only what you kept onto a new local branch. Push and the pull request each wait for your click.'],
    link: [`${BLOB}/docs/continuity.md`, 'Continuity and recovery'],
  },
  {
    icon: 'lock', h: 'Permissions',
    p: ['An edit or a command outside the read-only set waits in the thread with its exact target. You choose Allow once, Allow for this thread or Deny, and the default asks every time. A changed script asks again.'],
  },
  {
    icon: 'eye', h: 'Redaction',
    p: ['Check output, exports, share pages and the diagnostics bundle are redacted before they are shown or written. Provider output renders as inert text in a sandboxed renderer.'],
  },
  {
    icon: 'key', h: 'Credentials and billing',
    p: ['Cloud sign-in stays with each provider\'s own client. CrewKite never reads or stores a provider credential, sets no API key and never falls back to paid API billing. The one secret it can keep is the token of a model runtime on this device, and only when you turn on Remember on this device.'],
  },
  {
    icon: 'code', h: 'Provider terms',
    p: ['OpenAI, Anthropic and Local run through their own clients on their supported subscription paths.', 'Google\'s third-party access FAQ says that third-party access through its coding client login violates its terms. Google does not name CrewKite, and CrewKite has no exception from Google. Using the Google route is your own choice and your own risk. The app keeps Connect Google off until you tick a box that says you have read Google\'s terms, accept the risk, and that Roots No Limits LLC is not liable for Google\'s actions against your account.'],
    link: [`${BLOB}/docs/providers.md#google-and-your-account`, 'Google and your account'],
  },
];
---
<Base title="Safety: how CrewKite handles authority" description="How CrewKite keeps authority in code, works in scratch copies, asks before edits and commands, redacts output and leaves provider sign-in with each provider's own client." path="/safety">
  <section class="s-hero">
    <div class="wrap">
      <span class="eyebrow">Safety</span>
      <h1 class="s-h">How CrewKite handles authority</h1>
      <p class="lede">I built CrewKite for my own repositories and my own accounts, so it starts from what a model must not be able to do. These are the rules the controller enforces.</p>
    </div>
  </section>

  <section class="s-body">
    <div class="wrap s-grid">
      {parts.map((x, i) => (
        <article class="s-card reveal" style={`--d:${(i % 2) * 70}ms`}>
          <span class="s-ico"><Icon name={x.icon as any} size={20} /></span>
          <h2>{x.h}</h2>
          {x.p.map((t) => <p>{t}</p>)}
          {x.link && <a class="s-link" href={x.link[0]}>{x.link[1]} <Icon name="arrow" size={15} /></a>}
        </article>
      ))}
    </div>
  </section>

  <section class="s-limits">
    <div class="wrap">
      <div class="limits reveal">
        <h2>What it does not claim</h2>
        <ul>
          <li>Containment of a compromised official client. The first release trusts each client's own permission system.</li>
          <li>Protection against malware running as the same user.</li>
          <li>Safety guarantees for routes that have not passed qualification. Unsupported or unsafe routes fail closed.</li>
        </ul>
        <p>Report a security issue privately through GitHub as <a href={`${BLOB}/SECURITY.md`}>SECURITY.md</a> describes.</p>
        <a class="btn btn-primary" href={`${BLOB}/docs/architecture.md`}>Read the docs on GitHub <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .s-hero { padding: var(--space-16) 0 var(--space-6); }
  .s-h { margin-top: var(--space-4); font-size: var(--text-display); letter-spacing: var(--tracking-display); max-width: 18ch; }
  .s-body { padding-top: var(--space-8); }
  .s-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .s-card {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    transition-delay: var(--d, 0ms);
  }
  .s-ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .s-card h2 { font-size: var(--text-xl); }
  .s-card p { color: var(--text-muted); }
  .s-link { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); color: var(--accent); font-weight: var(--weight-semibold); text-decoration: none; font-size: var(--text-md); }
  .s-limits { padding-top: 0; }
  .limits {
    padding: var(--space-10);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border-strong);
  }
  .limits h2 { font-size: var(--text-h3); }
  .limits ul { margin: var(--space-4) 0; padding-left: var(--space-6); color: var(--text-muted); display: grid; gap: var(--space-2); }
  .limits p { color: var(--text-muted); margin-bottom: var(--space-6); }
  .limits p a { color: var(--text); }
  @media (max-width: 767px) {
    .s-grid { grid-template-columns: 1fr; }
    .limits { padding: var(--space-6) var(--space-4); }
  }
</style>
