---
// Plain text with a copy button and no mailto link. The address is one text node, so every reader,
// screen reader and text extractor gets exactly the same string.
import Icon from './Icon.astro';
---
<span class="email"><span class="email-t">ray@rootsnolimits.com</span><button class="copy email-copy" type="button" data-copy-email aria-label="Copy email address" hidden><Icon name="copy" size={13} /></button></span>

<style>
  .email {
    display: inline-flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--text);
    white-space: nowrap;
  }
  .email-copy {
    margin-left: 8px;
    height: 24px;
    padding: 0 7px;
  }
</style>
