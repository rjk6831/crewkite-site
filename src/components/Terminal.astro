---
// An illustrative CLI session drawn from the recorded one in docs/images/cli-session.txt and the
// commands in docs/preview.md, with the 0.1.0 crew and providers in GOAL order. It is coded, never a
// capture, and says so. Boxes are drawn with CSS so they line up in any font. Without
// JavaScript or with reduced motion every line shows at once.
import Kite from './Kite.astro';
---
<figure class="term" data-term aria-label="Illustrative CrewKite CLI session: usage for Google, OpenAI, Anthropic and Local, the model menu with each crew role marked, a message to the Opus 5.5 orchestrator and an edit permission prompt">
  <div class="term-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span>crewkite</span><span class="term-tag">Illustrative</span></div>
  <div class="term-body" aria-hidden="true">
    <div class="tl" data-t="0"><span class="dim">$</span> crewkite</div>
    <div class="tl brand" data-t="1"><Kite size={34} tail /><span class="word">CrewKite</span></div>
    <div class="tl status" data-t="2">
      <span><b class="g">G</b> <i class="bar bg"><i></i></i> 5 h 100%</span>
      <span><b class="o">O</b> <i class="bar bo"><i></i></i> 98%</span>
      <span><b class="a">A</b> <i class="bar ba"><i></i></i> 87%</span>
      <span><b class="l">L</b> ∞</span>
    </div>
    <div class="tl box" data-t="2"><span class="typed" data-type>/model</span></div>
    <div class="tl menu" data-t="3">
      <div class="m-h dim">Model for the next message</div>
      <div class="m-r"><b class="g">G</b><span>gemini-4-argon <em>Fixer</em></span></div>
      <div class="m-r"><b class="o">O</b><span>gpt-6.1-sol <em>Builder</em></span><span>gpt-6-astra <em>Reviewer</em></span></div>
      <div class="m-r m-on"><b class="a">A</b><span>Opus 5.5 <em>Orchestrator, Challenger</em></span></div>
      <div class="m-r"><b class="l">L</b><span>gpt-oss-20b <em>Ask</em></span></div>
    </div>
    <div class="tl gap" data-t="4"><span class="dim">›</span> Harden slugify for whitespace and punctuation</div>
    <div class="tl" data-t="4"><b class="a">A</b> Opus 5.5 <span class="dim">Orchestrator</span> <span class="acc">◆</span>&nbsp;&nbsp;<span class="dim">Waiting for you</span></div>
    <div class="tl in1" data-t="4"><span class="ok">✓</span> Read 2 files, searched once</div>
    <div class="tl in1" data-t="5">Runs of spaces become one hyphen, and punctuation drops out.</div>
    <div class="tl code in1" data-t="5">return name.trim().toLowerCase().replace(/\s+/g, '-');</div>
    <div class="tl perm in1" data-t="6">
      <div>Edit src/slug.js?</div>
      <div><span class="acc">[1] Allow once</span>&nbsp;&nbsp;&nbsp;[2] Deny</div>
      <div class="dim">Thread policy: Ask each time.</div>
    </div>
  </div>
</figure>

<style>
  .term {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--terminal-line);
    background: var(--terminal-bg);
    color: var(--terminal-text);
    box-shadow: var(--elevation-3);
    overflow: hidden;
  }
  .term :global(.kite) { --background: var(--terminal-bg); }
  .term-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 38px;
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--terminal-rule);
    font: 500 var(--text-xs)/1 var(--font-mono);
    color: var(--terminal-dim);
  }
  .dots { display: flex; gap: var(--space-2); }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--terminal-dot); }
  .term-body {
    padding: var(--space-4) var(--space-6) var(--space-6);
    font: 400 var(--text-sm)/1.7 var(--font-mono);
    min-height: 500px;
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
  }
  .tl { transition: opacity var(--duration-moderate) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tl:not(.on) { opacity: 0; }
  }
  .box :global(.w) { transition: opacity var(--duration-instant); }
  .box :global(.w.off) { opacity: 0; }
  .brand { display: flex; align-items: center; gap: var(--space-4); margin: var(--space-3) 0 var(--space-4); }
  .word { font-size: var(--text-xl); font-weight: var(--weight-bold); letter-spacing: var(--tracking-caps); color: var(--terminal-bright); }
  .box {
    border: 1px solid var(--terminal-line-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    color: var(--terminal-bright);
  }
  .status { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-6); color: var(--terminal-dim); font-size: var(--text-xs); margin-bottom: var(--space-3); }
  .bar { display: inline-block; width: 44px; height: 8px; border-radius: var(--radius-sm); background: var(--terminal-line); vertical-align: 0; overflow: hidden; }
  .bar i { display: block; width: 30%; height: 100%; background: var(--terminal-amber); }
  .gap { margin-top: var(--space-1); }
  .in1 { padding-left: var(--space-4); }
  .in2 { padding-left: var(--space-8); }
  .code {
    margin: var(--space-2) 0 var(--space-2) var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--terminal-line);
    border-radius: var(--radius-sm);
    color: var(--terminal-green);
    font-size: var(--text-xs);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .perm {
    margin: var(--space-2) 0 0 var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 3px double var(--terminal-amber);
    border-radius: var(--radius-sm);
    color: var(--terminal-amber);
  }
  .term-tag {
    margin-left: auto;
    font-size: var(--text-2xs);
    padding: var(--space-1) var(--space-2);
    border: 1px dashed var(--terminal-line-strong);
    border-radius: var(--radius-sm);
  }
  .menu {
    margin: var(--space-2) 0 var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--terminal-line-strong);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-1);
  }
  .m-h { font-size: var(--text-xs); margin-bottom: var(--space-0-5); }
  .m-r { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-4); padding: 1px var(--space-2); border-radius: var(--radius-sm); }
  .m-r b { width: 1ch; }
  .m-r em { font-style: normal; color: var(--terminal-dim); }
  .m-on { background: var(--terminal-highlight); }
  .m-on span:first-of-type { color: var(--terminal-accent); }
  .g { color: var(--terminal-google); font-weight: var(--weight-regular); }
  .bar.bo i { width: 98%; background: var(--family-openai-fill); }
  .bar.ba i { width: 87%; background: var(--family-anthropic-fill); }
  .bar.bg i { width: 100%; background: var(--family-google-fill); }
  .o { color: var(--terminal-openai); font-weight: var(--weight-regular); }
  .a { color: var(--terminal-anthropic); font-weight: var(--weight-regular); }
  .l { color: var(--terminal-local); font-weight: var(--weight-regular); }
  .acc { color: var(--terminal-accent); }
  .ok { color: var(--terminal-green); }
  .dim { color: var(--terminal-dim); }
  @media (max-width: 480px) {
    .term-body { font-size: var(--text-xs); padding: var(--space-4) var(--space-3); min-height: 0; }
    .in1 { padding-left: var(--space-2); }
    .in2 { padding-left: var(--space-4); }
    .code, .perm { margin-left: var(--space-2); }
  }
</style>
