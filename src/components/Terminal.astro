---
// An illustrative CLI session drawn from the recorded one in docs/images/cli-session.txt, with the
// model names the app shows. Boxes are drawn with CSS so they line up in any font. Without
// JavaScript or with reduced motion every line shows at once.
import Kite from './Kite.astro';
---
<figure class="term" data-term aria-label="Illustrative CrewKite CLI session: the model menu, a message on Opus 5.5 and an edit permission prompt">
  <div class="term-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span>crewkite</span><span class="term-tag">Illustrative</span></div>
  <div class="term-body" aria-hidden="true">
    <div class="tl" data-t="0"><span class="dim">$</span> crewkite</div>
    <div class="tl brand" data-t="1"><Kite size={34} tail /><span class="word">CrewKite</span></div>
    <div class="tl status" data-t="2">
      <span><b class="o">O</b> <i class="bar bo"><i></i></i> 98%</span>
      <span><b class="a">A</b> <i class="bar ba"><i></i></i> 5 h 87%</span>
      <span><b class="g">G</b> <i class="bar bg"><i></i></i> 5 h 100%</span>
      <span><b class="l">L</b> ∞</span>
    </div>
    <div class="tl box" data-t="2"><span class="typed" data-type>/model</span></div>
    <div class="tl menu" data-t="3">
      <div class="m-h dim">Model for the next message</div>
      <div class="m-r m-on"><b class="a">A</b><span>Opus 5.5</span><span>Fable 5.1</span><span>Sonnet 5.5</span></div>
      <div class="m-r"><b class="o">O</b><span>gpt-6.1-sol</span></div>
      <div class="m-r"><b class="g">G</b><span>gemini-3.8-flash</span></div>
      <div class="m-r"><b class="l">L</b><span>Flint</span></div>
    </div>
    <div class="tl gap" data-t="4"><span class="dim">›</span> Clamp the discount at the subtotal</div>
    <div class="tl" data-t="4"><b class="a">A</b> Opus 5.5 <span class="acc">◆</span>&nbsp;&nbsp;<span class="dim">Waiting for you</span></div>
    <div class="tl in1" data-t="4"><span class="ok">✓</span> Read 2 files, searched once</div>
    <div class="tl in1" data-t="5">The discount can push the total below zero. I will clamp it.</div>
    <div class="tl code in1" data-t="5">return subtotal - Math.min(discount, subtotal);</div>
    <div class="tl perm in1" data-t="6">
      <div>Edit net.mjs?</div>
      <div><span class="acc">[1] Allow once</span>&nbsp;&nbsp;&nbsp;[2] Deny</div>
      <div class="dim">Thread policy: Ask each time.</div>
    </div>
  </div>
</figure>

<style>
  .term {
    margin: 0;
    border-radius: 14px;
    border: 1px solid #2b3033;
    background: #0d0f10;
    color: #d6dbd9;
    box-shadow: var(--shadow);
    overflow: hidden;
    --tbg: #0d0f10;
  }
  .term :global(.kite) { --bg: #0d0f10; }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 38px;
    padding: 0 14px;
    border-bottom: 1px solid #22272a;
    font: 500 12px/1 var(--mono);
    color: #8f9996;
  }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #2f3538; }
  .term-body {
    padding: 18px 20px 22px;
    font: 400 13px/1.7 var(--mono);
    min-height: 500px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tl { transition: opacity 300ms var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tl:not(.on) { opacity: 0; }
  }
  .box :global(.w) { transition: opacity 120ms; }
  .box :global(.w.off) { opacity: 0; }
  .brand { display: flex; align-items: center; gap: 14px; margin: 10px 0 14px; }
  .word { font-size: 22px; font-weight: 800; letter-spacing: 0.02em; color: #e5e8e7; }
  .box {
    border: 1px solid #3a4145;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e5e8e7;
  }
  .status { display: flex; flex-wrap: wrap; gap: 4px 20px; color: #8f9996; font-size: 12px; margin-bottom: 10px; }
  .bar { display: inline-block; width: 44px; height: 8px; border-radius: 2px; background: #2b3033; vertical-align: 0; overflow: hidden; }
  .bar i { display: block; width: 30%; height: 100%; background: #e1be83; }
  .gap { margin-top: 4px; }
  .in1 { padding-left: 16px; }
  .in2 { padding-left: 28px; }
  .code {
    margin: 6px 0 6px 16px;
    padding: 6px 12px;
    border: 1px solid #2b3033;
    border-radius: 8px;
    color: #9ed3ad;
    font-size: 12px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .perm {
    margin: 6px 0 0 16px;
    padding: 8px 12px;
    border: 3px double #e1be83;
    border-radius: 4px;
    color: #e1be83;
  }
  .term-tag {
    margin-left: auto;
    font-size: 10.5px;
    padding: 4px 7px;
    border: 1px dashed #3a4145;
    border-radius: 6px;
  }
  .menu {
    margin: 6px 0 8px;
    padding: 8px 10px;
    border: 1px solid #3a4145;
    border-radius: 8px;
    display: grid;
    gap: 3px;
  }
  .m-h { font-size: 11.5px; margin-bottom: 2px; }
  .m-r { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; padding: 1px 6px; border-radius: 5px; }
  .m-r b { width: 1ch; }
  .m-on { background: #1d2224; }
  .m-on span:first-of-type { color: #d0e7a1; }
  .g { color: #9aa2ec; font-weight: 400; }
  .bar.bo i { width: 98%; background: #40b0a8; }
  .bar.ba i { width: 87%; background: #e87860; }
  .bar.bg i { width: 100%; background: #4850a8; }
  .o { color: #5fcfc4; font-weight: 400; }
  .a { color: #f0917c; font-weight: 400; }
  .l { color: #e8c56e; font-weight: 400; }
  .acc { color: #d0e7a1; }
  .ok { color: #9ed3ad; }
  .dim { color: #8f9996; }
  @media (max-width: 480px) {
    .term-body { font-size: 11.5px; padding: 14px 12px; min-height: 0; }
    .in1 { padding-left: 8px; }
    .in2 { padding-left: 16px; }
    .code, .perm { margin-left: 8px; }
  }
</style>
