---
import Kite from './Kite.astro';
import Icon from './Icon.astro';
// An illustrative replay of one thread, drawn with the app's tokens and the preview project's data.
// Without JavaScript or with reduced motion it shows the finished thread as a still frame.

// Final values match the reference screenshot. The script starts a little higher and counts down.
const gauges = [
  { fam: 'o', name: 'OpenAI', rows: [{ key: 'o5', label: '5 h', v: 0 }, { key: 'ow', label: 'week', v: 80 }], sub: 'resets in 1 h 40 min' },
  { fam: 'a', name: 'Anthropic', rows: [{ key: 'a5', label: '', v: 30, suffix: ' left' }], sub: 'resets in 2 h' },
  { fam: 'g', name: 'Google', rows: [{ key: 'g5', label: '5 h', v: 85 }, { key: 'gw', label: 'week', v: 65 }], sub: 'resets in 3 d' },
];
---
<figure class="replay" data-replay aria-label="Illustrative replay of one CrewKite thread: OpenAI plans, the thread moves to Anthropic at OpenAI's limit, Anthropic starts subagents and edits, Google answers a side question, a local model reviews, and Accept makes a branch">
  <div class="win">
    <div class="win-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="win-fam" aria-hidden="true"><span class="fam fam-a" data-cur>A</span></span>
      <span class="win-title">Add netMinor(subtotalMinor, discountMinor) <em>demo-shop</em></span>
      <span class="win-tag">Illustrative replay</span>
      <button class="rp-toggle" type="button" data-replay-toggle aria-label="Pause replay" hidden>
        <span class="i-pause"><Icon name="pause" size={14} /></span>
        <span class="i-play"><Icon name="play" size={14} /></span>
      </button>
    </div>

    <div class="strip" aria-hidden="true">
      <span class="sg" data-row="o"><span class="fam fam-o">O</span><span class="sg-bar" style="--c:var(--openai-fill)"><i data-g="o5" style="--v:0"></i></span><b><span data-gt="o5">0</span>%</b></span>
      <span class="sg" data-row="a"><span class="fam fam-a">A</span><span class="sg-bar" style="--c:var(--anthropic-fill)"><i data-g="a5" style="--v:30"></i></span><b><span data-gt="a5">30</span>%</b></span>
      <span class="sg" data-row="g"><span class="fam fam-g">G</span><span class="sg-bar" style="--c:var(--google-fill)"><i data-g="g5" style="--v:85"></i></span><b><span data-gt="g5">85</span>%</b></span>
      <span class="sg" data-row="l"><span class="fam fam-l">L</span><span class="sg-bar sg-inf" style="--c:var(--local-fill)"><i style="--v:100"></i></span>∞</span>
    </div>

    <div class="win-body">
      <aside class="rail" aria-hidden="true">
        <div class="rail-brand"><Kite size={16} /><b>CrewKite</b></div>
        <div class="rail-item"><Icon name="plus" size={14} /> New thread</div>
        <div class="rail-label">Projects</div>
        <div class="rail-proj">demo-shop</div>
        <div class="rail-thread"><span class="dot" data-run></span>Add netMinor(subtotal…</div>
        <div class="rail-gauges">
          {gauges.map((g) => (
            <div class="g" data-row={g.fam}>
              <div class="g-name"><span class={`fam fam-${g.fam}`}>{g.fam.toUpperCase()}</span>{g.name}<span class="live" /></div>
              {g.rows.map((r) => (
                <div class="g-line">
                  <span class="g-bar" style={`--c:var(--${g.name === 'OpenAI' ? 'openai' : g.name === 'Anthropic' ? 'anthropic' : 'google'}-fill)`}><i data-g={r.key} style={`--v:${r.v}`}></i></span>
                  <span class="g-val">{r.label && `${r.label} `}<span data-gt={r.key}>{r.v}</span>%{r.suffix ?? ''}</span>
                </div>
              ))}
              <div class="g-sub">{g.sub}</div>
            </div>
          ))}
          <div class="g" data-row="l">
            <div class="g-name"><span class="fam fam-l">L</span>Local<span class="live" /></div>
            <div class="g-line">
              <span class="g-bar g-inf" style="--c:var(--local-fill)"><i></i><em>∞</em><i></i></span>
              <span class="g-val">No limits</span>
            </div>
          </div>
        </div>
      </aside>

      <div class="thread" aria-hidden="true">
        <div class="thread-inner">
          <div class="it user" data-at="0">Add netMinor(subtotalMinor, discountMinor) to net.mjs. It must never return less than zero.</div>

          <div class="it turn" data-at="1">
            <div class="turn-h"><span class="fam fam-o">O</span>OpenAI · plan</div>
            <p data-type>The function is a stub. I will validate both inputs as safe integers, clamp the result at zero, then run the tests.</p>
          </div>

          <div class="it divider" data-at="3"><span>Continued on Anthropic from OpenAI. Reason: five-hour limit reached, resets in 1 h 40 min.</span></div>

          <div class="it turn" data-at="4">
            <div class="turn-h"><span class="fam fam-a">A</span>Anthropic · Opus 5.5</div>
            <div class="card spawn">
              <div class="spawn-h"><Icon name="branch" size={14} /><span>Task: find every caller of netMinor</span><span class="badge"><span data-sub-count>3</span> subagents</span></div>
              <div class="sub" data-sub="1"><span class="sub-s ok-s"><Icon name="check" size={13} /></span>Subagent 1 <code>src/cart.mjs</code><span class="sub-m">Sonnet 5.5</span></div>
              <div class="sub" data-sub="2"><span class="sub-s ok-s"><Icon name="check" size={13} /></span>Subagent 2 <code>src/checkout.mjs</code><span class="sub-m">Sonnet 5.5</span></div>
              <div class="sub" data-sub="3"><span class="sub-s ok-s"><Icon name="check" size={13} /></span>Subagent 3 <code>test/</code><span class="sub-m">Sonnet 5.5</span></div>
            </div>
          </div>

          <div class="it" data-at="5">
            <p data-type>netMinor is a stub today. I am replacing it with a version that checks both inputs are non-negative safe integers and returns the subtotal minus the discount, never below zero.</p>
          </div>

          <div class="it card diff" data-at="6">
            <div class="diff-h"><code>Edit net.mjs</code><span class="ok"><Icon name="check" size={14} /></span></div>
            <pre><span class="hunk">@@ -1,3 +1,6 @@</span><span class="del">-export function netMinor() &#123;</span><span class="del">-  throw new Error('netMinor is not implemented.');</span><span class="add">+export function netMinor(subtotalMinor, discountMinor) &#123;</span><span class="add">+  if (![subtotalMinor, discountMinor].every((v) =&gt; Number.isSafeInteger(v) &amp;&amp; v &gt;= 0)) &#123;</span><span class="add">+    throw new RangeError('Amounts must be non-negative safe integers.');</span><span class="add">+  &#125;</span><span class="add">+  return Math.max(0, subtotalMinor - discountMinor);</span><span> &#125;</span></pre>
            <div class="diff-f"><code>net.mjs <b class="plus">+5</b> <b class="minus">-2</b></code><span class="link">Open in Changes</span></div>
          </div>

          <div class="it card perm" data-at="7">
            <div class="perm-q"><Icon name="shield" size={16} />Run the tests in the scratch copy?</div>
            <code class="perm-cmd">node --test</code>
            <div class="perm-actions">
              <span class="pbtn primary" data-press="8">Allow once</span>
              <span class="pbtn">Allow for this thread</span>
              <span class="pbtn deny">Deny</span>
            </div>
          </div>

          <div class="it turn ask" data-at="9">
            <div class="turn-h"><span class="fam fam-g">G</span>Google · ask<span class="ask-b">Ask</span></div>
            <p data-type>The clamp is right. A test where the discount exceeds the subtotal would pin that edge.</p>
          </div>

          <div class="it turn" data-at="10">
            <div class="turn-h"><span class="fam fam-l">L</span>Local · review</div>
            <p data-type>Tests pass in the scratch copy. The clamp holds when the discount equals or exceeds the subtotal. No changes needed.</p>
          </div>

          <div class="it card accept" data-at="11">
            <div class="acc-row">
              <span><Icon name="branch" size={15} /><code>add-netminor</code></span>
              <span class="pbtn primary" data-press="12">Accept to branch</span>
            </div>
            <div class="acc-done" data-at="12"><Icon name="check" size={14} />Committed on a new local branch. Your checkout is unchanged.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="caption">
    <span data-caption>Accept makes a new local branch.</span>
  </figcaption>
</figure>

<style>
  .replay {
    margin: 0;
    position: relative;
  }
  .win {
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
    overflow: hidden;
    text-align: left;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 42px;
    padding: 0 12px 0 14px;
    border-bottom: 1px solid var(--border);
    background: var(--sidebar);
  }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--border-strong); }
  .win-fam .fam { transition: color 300ms; }
  .win-title {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win-title em { font-style: normal; color: var(--text-dim); margin-left: 6px; }
  .win-tag {
    flex: none;
    font: 500 11px/1 var(--mono);
    color: var(--text-dim);
    padding: 5px 8px;
    border: 1px dashed var(--border-strong);
    border-radius: 6px;
  }
  .rp-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .rp-toggle .i-play { display: none; }
  .paused .rp-toggle .i-play { display: block; }
  .paused .rp-toggle .i-pause { display: none; }

  .strip { display: none; }

  .win-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    height: 600px;
  }
  .rail {
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .rail-brand { display: flex; align-items: center; gap: 7px; color: var(--text); font-size: 14px; margin-bottom: 6px; }
  .rail-item { display: flex; gap: 8px; align-items: center; padding: 5px 6px; }
  .rail-label {
    margin-top: 8px;
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 6px;
  }
  .rail-proj { padding: 4px 6px; color: var(--text); }
  .rail-thread {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px;
    border-radius: 7px;
    background: var(--surface-raised);
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-dim); flex: none; }
  .running .dot[data-run] { background: var(--accent); animation: pulse 1.4s infinite; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 var(--accent-soft); }
    50% { box-shadow: 0 0 0 5px transparent; }
  }

  .rail-gauges {
    margin-top: auto;
    display: grid;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .g { position: relative; padding: 2px 4px; border-radius: 7px; transition: background 300ms; }
  .g.on { background: var(--surface); }
  .g-name { display: flex; align-items: center; gap: 7px; color: var(--text); margin-bottom: 3px; }
  .g-name .fam, .strip .fam { width: 16px; height: 16px; font-size: 9px; }
  .live {
    width: 6px;
    height: 6px;
    margin-left: auto;
    border-radius: 50%;
    background: transparent;
  }
  .g.on .live { background: var(--accent); animation: pulse 1.4s infinite; }
  .g-line { display: flex; align-items: center; gap: 10px; }
  .g-bar {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .g-bar i {
    display: block;
    height: 100%;
    width: calc(var(--v) * 1%);
    background: var(--c);
    border-radius: 2px;
    transition: width 700ms var(--ease);
  }
  .g-inf {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 12px;
    background: transparent;
    overflow: visible;
  }
  .g-inf i { flex: 1; width: auto; height: 3px; }
  .g-inf em { font-style: normal; color: var(--local); font-size: 13px; line-height: 1; }
  .g[data-row='l'].on .g-inf em { animation: inf 1.6s var(--ease) infinite; }
  @keyframes inf { 50% { transform: scale(1.3); } }
  .g-val { min-width: 74px; text-align: right; font-size: 12px; color: var(--text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .g-sub { font-size: 11.5px; color: var(--text-dim); margin-top: 2px; }

  .thread {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .thread-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 28px 24px;
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.6;
  }
  .it,
  .acc-done,
  .sub {
    transition: opacity 420ms var(--ease), filter 420ms var(--ease);
  }
  /* With motion allowed, items start invisible from the first paint and only change opacity, so the
     replay never moves layout. The thread scrolls with a transform. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .thread { justify-content: flex-start; }
    :global(.js) .thread-inner { padding-top: 24px; transition: transform 600ms var(--ease); will-change: transform; }
    :global(.js) .it:not(.on),
    :global(.js) .acc-done:not(.on),
    :global(.js) .sub:not(.on) { opacity: 0; filter: blur(2px); }
  }
  .user {
    align-self: flex-end;
    max-width: 78%;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    padding: 9px 13px;
    border-radius: 12px 12px 4px 12px;
  }
  .turn-h { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-muted); margin-bottom: 6px; }
  .turn-h .fam { width: 16px; height: 16px; font-size: 9px; }
  .ask-b {
    margin-left: 4px;
    font-size: 11px;
    padding: 1px 7px;
    border-radius: 999px;
    color: var(--google);
    border: 1px solid color-mix(in srgb, var(--google) 50%, transparent);
  }
  .ask { padding-left: 12px; border-left: 2px solid color-mix(in srgb, var(--google) 60%, transparent); }
  .turn { display: grid; gap: 8px; }
  .divider { display: flex; align-items: center; gap: 12px; font-size: 12.5px; color: var(--text-muted); text-align: center; }
  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    min-width: 16px;
    height: 1px;
    background: linear-gradient(90deg, var(--openai), var(--anthropic));
    opacity: 0.6;
  }
  .card { border: 1px solid var(--border); background: var(--surface); border-radius: 9px; }
  .spawn { overflow: hidden; }
  .spawn-h {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font-size: 13px;
    border-bottom: 1px solid var(--border);
  }
  .spawn-h :global(svg) { color: var(--text-dim); flex: none; }
  .spawn-h > span:first-of-type { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .badge {
    margin-left: auto;
    flex: none;
    font: 500 11px/1 var(--mono);
    padding: 4px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--anthropic) 10%, transparent);
    color: var(--anthropic);
    font-variant-numeric: tabular-nums;
  }
  .sub {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 12px;
    font-size: 13px;
    white-space: nowrap;
  }
  .sub + .sub { border-top: 1px solid var(--border); }
  .sub code { color: var(--text-muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; }
  .sub-m { margin-left: auto; font-size: 11.5px; color: var(--text-dim); }
  .sub-s { position: relative; display: inline-flex; width: 13px; height: 13px; color: var(--green); }
  .sub.running .sub-s :global(svg) { opacity: 0; }
  .sub.running .sub-s::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    border-top-color: var(--blue);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .ok { margin-left: auto; color: var(--green); display: inline-flex; }
  .diff-h,
  .diff-f { display: flex; align-items: center; padding: 8px 12px; font-size: 13px; }
  .diff-f { border-top: 1px solid var(--border); color: var(--text-muted); font-size: 12px; }
  .diff-f .link { margin-left: auto; color: var(--accent); font-size: 12px; }
  .plus { color: var(--green); font-weight: 500; }
  .minus { color: var(--red); font-weight: 500; }
  .diff pre {
    margin: 0;
    padding: 8px 0;
    border-top: 1px solid var(--border);
    font: 400 12px/1.65 var(--mono);
    overflow: hidden;
    white-space: pre;
  }
  .diff pre span { display: block; padding: 0 12px; }
  .hunk { color: var(--blue); }
  .del { background: var(--diff-del); color: var(--red); }
  .add { background: var(--diff-add); color: var(--green); }
  .perm { padding: 12px; border-color: var(--amber); display: grid; gap: 10px; }
  .perm-q { display: flex; align-items: center; gap: 8px; font-weight: 500; }
  .perm-q :global(svg) { color: var(--amber); }
  .perm-cmd {
    display: block;
    padding: 8px 10px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--sidebar);
    font-size: 12.5px;
  }
  .perm-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .pbtn {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    font-size: 13px;
    font-weight: 500;
    transition: transform 140ms var(--ease), box-shadow 200ms var(--ease);
  }
  .pbtn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .pbtn.deny { color: var(--red); }
  .pbtn.pressed { transform: scale(0.95); box-shadow: 0 0 0 4px var(--accent-soft); }
  .accept { padding: 10px 12px; display: grid; gap: 8px; }
  .acc-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .acc-row > span:first-child { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); }
  .acc-done { display: flex; align-items: center; gap: 8px; color: var(--green); font-size: 13px; }
  [data-type] :global(.w) { transition: opacity 160ms; }
  [data-type] :global(.w.off) { opacity: 0; }

  .caption {
    display: block;
    width: min(560px, calc(100% - 24px));
    min-height: 38px;
    margin: 16px auto 0;
    text-align: center;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
  }
  .caption span { display: inline-block; transition: opacity 250ms, transform 250ms; }
  .caption span.swap { opacity: 0; transform: translateY(4px); }

  @media (max-width: 860px) {
    .win-body { grid-template-columns: 1fr; height: 520px; }
    .rail { display: none; }
    .strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      background: var(--sidebar);
      font: 500 11.5px/1 var(--mono);
      color: var(--text-muted);
    }
    .sg { display: flex; align-items: center; gap: 6px; min-width: 0; padding: 3px; border-radius: 6px; transition: background 300ms; }
    .sg.on { background: var(--surface); color: var(--text); }
    .sg b { font-weight: 500; font-variant-numeric: tabular-nums; }
    .sg-bar { flex: 1; min-width: 12px; height: 3px; border-radius: 2px; background: var(--border); overflow: hidden; }
    .sg-bar i { display: block; height: 100%; width: calc(var(--v) * 1%); background: var(--c); transition: width 700ms var(--ease); }
    .thread-inner { padding: 16px 14px 20px; font-size: 13.5px; }
    .diff pre { font-size: 11px; }
    .win-title em { display: none; }
  }
  @media (max-width: 480px) {
    .win-body { height: 480px; }
    .win-title { display: none; }
    .win-tag { margin-left: auto; }
    .strip { gap: 6px; padding: 8px 10px; font-size: 10.5px; }
    .caption { font-size: 12.5px; border-radius: 14px; min-height: 54px; display: grid; place-items: center; }
    .perm-actions .pbtn:nth-child(2) { display: none; }
  }
</style>
