---
import Kite from './Kite.astro';
import Icon from './Icon.astro';
// An illustrative replay of one thread, drawn with the app's tokens and the preview project's data.
// Without JavaScript or with reduced motion it shows the finished thread as a still frame.

// The rail in GOAL order (Google, OpenAI, Anthropic, Local), as the app shows it. Google reports a
// five-hour and a weekly window, OpenAI a weekly one; Anthropic's windows depend on the plan, so the
// replay shows its remaining allowance with no window named. Readings are illustrative.
const gauges = [
  { fam: 'g', name: 'Google', rows: [{ key: 'g5', label: '5 h', v: 85 }, { key: 'gw', label: 'week', v: 65 }], sub: 'resets in 3 d' },
  { fam: 'o', name: 'OpenAI', rows: [{ key: 'ow', label: '', v: 80, suffix: ' left' }], sub: 'resets in 2 d' },
  { fam: 'a', name: 'Anthropic', rows: [{ key: 'a5', label: '', v: 0, suffix: ' left' }], sub: 'resets in 1 h 40 min' },
];
---
<figure class="replay" data-replay aria-label="Illustrative replay of one CrewKite thread: the Anthropic orchestrator plans and starts subagents, the thread moves to the OpenAI builder when Anthropic reaches its limit, a local model answers a side question beside the builder, the OpenAI reviewer finds a gap, the Google fixer closes it, and Accept makes a branch">
  <div class="win">
    <div class="win-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="win-fam" aria-hidden="true"><span class="fam fam-o" data-cur>O</span></span>
      <span class="win-title">Add netMinor(subtotalMinor, discountMinor) <em>demo-shop</em></span>
      <span class="win-tag">Illustrative replay</span>
      <button class="rp-toggle" type="button" data-replay-toggle aria-label="Pause replay" hidden>
        <span class="i-pause"><Icon name="pause" size={14} /></span>
        <span class="i-play"><Icon name="play" size={14} /></span>
      </button>
    </div>

    <div class="strip" aria-hidden="true">
      <span class="sg" data-row="g"><span class="fam fam-g">G</span><span class="sg-bar" style="--c:var(--family-google-fill)"><i data-g="g5" style="--v:85"></i></span><b><span data-gt="g5">85</span>%</b></span>
      <span class="sg" data-row="o"><span class="fam fam-o">O</span><span class="sg-bar" style="--c:var(--family-openai-fill)"><i data-g="ow" style="--v:80"></i></span><b><span data-gt="ow">80</span>%</b></span>
      <span class="sg" data-row="a"><span class="fam fam-a">A</span><span class="sg-bar" style="--c:var(--family-anthropic-fill)"><i data-g="a5" style="--v:0"></i></span><b><span data-gt="a5">0</span>%</b></span>
      <span class="sg" data-row="l"><span class="fam fam-l">L</span><span class="sg-bar sg-inf" style="--c:var(--family-local-fill)"><i style="--v:100"></i></span>∞</span>
    </div>

    <div class="win-body">
      <aside class="rail" aria-hidden="true">
        <div class="rail-brand"><Kite size={16} /><b>CrewKite</b></div>
        <div class="rail-item"><Icon name="plus" size={14} /> New thread</div>
        <div class="rail-label">Projects</div>
        <div class="rail-proj">demo-shop</div>
        <div class="rail-thread"><span class="dot" data-run></span>Add netMinor(subtotal…</div>
        <div class="rail-gauges">
          {gauges.map((g) => (
            <div class="g" data-row={g.fam}>
              <div class="g-name"><span class={`fam fam-${g.fam}`}>{g.fam.toUpperCase()}</span>{g.name}<span class="live" /></div>
              {g.rows.map((r) => (
                <div class="g-line">
                  <span class="g-bar" style={`--c:var(--family-${g.name === 'OpenAI' ? 'openai' : g.name === 'Anthropic' ? 'anthropic' : 'google'}-fill)`}><i data-g={r.key} style={`--v:${r.v}`}></i></span>
                  <span class="g-val">{r.label && `${r.label} `}<span data-gt={r.key}>{r.v}</span>%{r.suffix ?? ''}</span>
                </div>
              ))}
              <div class="g-sub">{g.sub}</div>
            </div>
          ))}
          <div class="g" data-row="l">
            <div class="g-name"><span class="fam fam-l">L</span>Local<span class="live" /></div>
            <div class="g-line">
              <span class="g-bar g-inf" style="--c:var(--family-local-fill)"><i></i><em>∞</em><i></i></span>
              <span class="g-val">No limits</span>
            </div>
          </div>
        </div>
      </aside>

      <div class="thread" aria-hidden="true">
        <div class="thread-inner">
          <div class="it user" data-at="0">Add netMinor(subtotalMinor, discountMinor) to net.mjs. It must never return less than zero.</div>

          <div class="it turn" data-at="1">
            <div class="turn-h"><span class="fam fam-a">A</span>Orchestrator · Anthropic Opus 5.5</div>
            <p data-type>The function is a stub. I will find every caller first, then validate both inputs as safe integers and clamp the result at zero.</p>
          </div>

          <div class="it card spawn" data-at="2">
            <div class="spawn-h"><Icon name="branch" size={14} /><span>Task: find every caller of netMinor</span><span class="badge"><span data-sub-count>3</span> subagents</span></div>
            <div class="sub" data-sub="1"><span class="sub-s ok-s"><Icon name="check" size={13} /></span>Subagent 1 <code>src/cart.mjs</code><span class="sub-m">Sonnet 5.5</span></div>
            <div class="sub" data-sub="2"><span class="sub-s ok-s"><Icon name="check" size={13} /></span>Subagent 2 <code>src/checkout.mjs</code><span class="sub-m">Sonnet 5.5</span></div>
            <div class="sub" data-sub="3"><span class="sub-s ok-s"><Icon name="check" size={13} /></span>Subagent 3 <code>test/</code><span class="sub-m">Sonnet 5.5</span></div>
          </div>

          <div class="it divider" data-at="3"><span>Continued on OpenAI (gpt-6.1-sol) from Anthropic (Opus 5.5). Reason: usage limit reached.</span></div>

          <div class="it turn" data-at="4">
            <div class="turn-h"><span class="fam fam-o">O</span>Builder · OpenAI gpt-6.1-sol</div>
            <p data-type>netMinor is a stub today. I am replacing it with a version that checks both inputs are non-negative safe integers and returns the subtotal minus the discount, never below zero.</p>
          </div>

          <div class="it card diff" data-at="6">
            <div class="diff-h"><code>Edit net.mjs</code><span class="ok"><Icon name="check" size={14} /></span></div>
            <pre><span class="hunk">@@ -1,3 +1,6 @@</span><span class="del">-export function netMinor() &#123;</span><span class="del">-  throw new Error('netMinor is not implemented.');</span><span class="add">+export function netMinor(subtotalMinor, discountMinor) &#123;</span><span class="add">+  if (![subtotalMinor, discountMinor].every((v) =&gt; Number.isSafeInteger(v) &amp;&amp; v &gt;= 0)) &#123;</span><span class="add">+    throw new RangeError('Amounts must be non-negative safe integers.');</span><span class="add">+  &#125;</span><span class="add">+  return Math.max(0, subtotalMinor - discountMinor);</span><span> &#125;</span></pre>
            <div class="diff-f"><code>net.mjs <b class="plus">+5</b> <b class="minus">-2</b></code><span class="link">Open in Changes</span></div>
          </div>

          <div class="it card perm" data-at="7">
            <div class="perm-q"><Icon name="shield" size={16} />Run the tests in the scratch copy?</div>
            <code class="perm-cmd">node --test</code>
            <div class="perm-actions">
              <span class="pbtn primary" data-press="8">Allow once</span>
              <span class="pbtn">Allow for this thread</span>
              <span class="pbtn deny">Deny</span>
            </div>
          </div>

          <div class="it turn ask" data-at="9">
            <div class="turn-h"><span class="fam fam-l">L</span>Local gpt-oss-20b<span class="ask-b">Ask</span></div>
            <p data-type>Discounts reach netMinor in minor units from cart.mjs, so both inputs are integers. The builder keeps running.</p>
          </div>

          <div class="it turn" data-at="10">
            <div class="turn-h"><span class="fam fam-o">O</span>Reviewer · OpenAI gpt-6-astra</div>
            <p data-type>Tests pass in the scratch copy. One gap: no test where the discount exceeds the subtotal.</p>
          </div>

          <div class="it turn" data-at="13">
            <div class="turn-h"><span class="fam fam-g">G</span>Fixer · Google gemini-4-argon</div>
            <p data-type>Added that test. Six of six pass.</p>
          </div>

          <div class="it card accept" data-at="11">
            <div class="acc-row">
              <span><Icon name="branch" size={15} /><code>add-netminor</code></span>
              <span class="pbtn primary" data-press="12">Accept to branch</span>
            </div>
            <div class="acc-done" data-at="12"><Icon name="check" size={14} />Committed on a new local branch. Your checkout is unchanged.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="caption">
    <span data-caption>Accept makes a new local branch.</span>
    <button class="rp-again" type="button" data-replay-again hidden><Icon name="play" size={13} />Replay</button>
  </figcaption>
</figure>

<style>
  .replay {
    margin: 0;
    position: relative;
  }
  .win {
    border-radius: var(--radius-lg);
    background: var(--background);
    border: 1px solid var(--border-strong);
    box-shadow: var(--elevation-3);
    overflow: hidden;
    text-align: left;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 42px;
    padding: 0 var(--space-3) 0 var(--space-4);
    border-bottom: 1px solid var(--border);
    background: var(--sidebar);
  }
  .dots { display: flex; gap: var(--space-2); }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--border-strong); }
  .win-fam .fam { transition: color var(--duration-moderate); }
  .win-title {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win-title em { font-style: normal; color: var(--text-dim); margin-left: var(--space-2); }
  .win-tag {
    flex: none;
    font: 500 var(--text-xs)/1 var(--font-mono);
    color: var(--text-dim);
    padding: var(--space-1) var(--space-2);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
  }
  .rp-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .rp-toggle .i-play { display: none; }
  .paused .rp-toggle .i-play { display: block; }
  .paused .rp-toggle .i-pause { display: none; }

  .strip { display: none; }

  .win-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    height: 600px;
  }
  .rail {
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: var(--space-4) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .rail-brand { display: flex; align-items: center; gap: var(--space-2); color: var(--text); font-size: var(--text-md); margin-bottom: var(--space-2); }
  .rail-item { display: flex; gap: var(--space-2); align-items: center; padding: var(--space-1) var(--space-2); }
  .rail-label {
    margin-top: var(--space-2);
    font: 500 var(--text-2xs)/1 var(--font-mono);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-dim);
    padding: var(--space-2);
  }
  .rail-proj { padding: var(--space-1) var(--space-2); color: var(--text); }
  .rail-thread {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-dim); flex: none; }
  .running .dot[data-run] { background: var(--accent); animation: pulse 1.4s infinite; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 var(--accent-soft); }
    50% { box-shadow: 0 0 0 5px transparent; }
  }

  .rail-gauges {
    margin-top: auto;
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .g { position: relative; padding: var(--space-0-5) var(--space-1); border-radius: var(--radius-sm); transition: background var(--duration-moderate); }
  .g.on { background: var(--surface); }
  .g-name { display: flex; align-items: center; gap: var(--space-2); color: var(--text); margin-bottom: var(--space-1); }
  .g-name .fam, .strip .fam { width: 16px; height: 16px; font-size: var(--text-2xs); }
  .live {
    width: 6px;
    height: 6px;
    margin-left: auto;
    border-radius: 50%;
    background: transparent;
  }
  .g.on .live { background: var(--accent); animation: pulse 1.4s infinite; }
  .g-line { display: flex; align-items: center; gap: var(--space-3); }
  .g-bar {
    flex: 1;
    height: 3px;
    border-radius: var(--radius-sm);
    background: var(--border);
    overflow: hidden;
  }
  .g-bar i {
    display: block;
    height: 100%;
    width: calc(var(--v) * 1%);
    background: var(--c);
    border-radius: var(--radius-sm);
    transition: width 700ms var(--ease-out);
  }
  .g-inf {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 12px;
    background: transparent;
    overflow: visible;
  }
  .g-inf i { flex: 1; width: auto; height: 3px; }
  .g-inf em { font-style: normal; color: var(--family-local); font-size: var(--text-sm); line-height: 1; }
  .g[data-row='l'].on .g-inf em { animation: inf 1.6s var(--ease-out) infinite; }
  @keyframes inf { 50% { transform: scale(1.3); } }
  .g-val { min-width: 74px; text-align: right; font-size: var(--text-xs); color: var(--text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .g-sub { font-size: var(--text-xs); color: var(--text-dim); margin-top: var(--space-0-5); }

  .thread {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .thread-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-8) var(--space-6);
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    font-size: var(--text-md);
    line-height: 1.6;
  }
  .it,
  .acc-done,
  .sub {
    transition: opacity 420ms var(--ease-out), filter 420ms var(--ease-out);
  }
  /* With motion allowed, items start invisible from the first paint and only change opacity, so the
     replay never moves layout. The thread scrolls with a transform. */
  /* A replay the visitor started steps through even with reduced motion, with no transitions. */
  .stepped .it:not(.on),
  .stepped .acc-done:not(.on),
  .stepped .sub:not(.on) { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .thread { justify-content: flex-start; }
    :global(.js) .thread-inner { padding-top: var(--space-6); transition: transform 600ms var(--ease-out); will-change: transform; }
    :global(.js) .it:not(.on),
    :global(.js) .acc-done:not(.on),
    :global(.js) .sub:not(.on) { opacity: 0; filter: blur(2px); }
  }
  .user {
    align-self: flex-end;
    max-width: 78%;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md) var(--radius-md) var(--radius-sm) var(--radius-md);
  }
  .turn-h { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--text-muted); margin-bottom: var(--space-2); }
  .turn-h .fam { width: 16px; height: 16px; font-size: var(--text-2xs); }
  .ask-b {
    margin-left: var(--space-1);
    font-size: var(--text-xs);
    padding: 1px var(--space-2);
    border-radius: var(--radius-lg);
    color: var(--family-google);
    border: 1px solid color-mix(in srgb, var(--family-google) 50%, transparent);
  }
  .ask { padding-left: var(--space-3); border-left: 2px solid color-mix(in srgb, var(--family-google) 60%, transparent); }
  .turn { display: grid; gap: var(--space-2); }
  .divider { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-xs); color: var(--text-muted); text-align: center; }
  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    min-width: 16px;
    height: 1px;
    background: linear-gradient(90deg, var(--family-anthropic), var(--family-openai));
    opacity: 0.6;
  }
  .card { border: 1px solid var(--border); background: var(--surface); border-radius: var(--radius-md); }
  .spawn { overflow: hidden; }
  .spawn-h {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--border);
  }
  .spawn-h :global(svg) { color: var(--text-dim); flex: none; }
  .spawn-h > span:first-of-type { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .badge {
    margin-left: auto;
    flex: none;
    font: 500 var(--text-xs)/1 var(--font-mono);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--family-anthropic) 10%, transparent);
    color: var(--family-anthropic);
    font-variant-numeric: tabular-nums;
  }
  .sub {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .sub + .sub { border-top: 1px solid var(--border); }
  .sub code { color: var(--text-muted); font-size: var(--text-xs); overflow: hidden; text-overflow: ellipsis; }
  .sub-m { margin-left: auto; font-size: var(--text-xs); color: var(--text-dim); }
  .sub-s { position: relative; display: inline-flex; width: 13px; height: 13px; color: var(--green); }
  .sub.running .sub-s :global(svg) { opacity: 0; }
  .sub.running .sub-s::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    border-top-color: var(--blue);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .ok { margin-left: auto; color: var(--green); display: inline-flex; }
  .diff-h,
  .diff-f { display: flex; align-items: center; padding: var(--space-2) var(--space-3); font-size: var(--text-sm); }
  .diff-f { border-top: 1px solid var(--border); color: var(--text-muted); font-size: var(--text-xs); }
  .diff-f .link { margin-left: auto; color: var(--accent); font-size: var(--text-xs); }
  .plus { color: var(--green); font-weight: var(--weight-medium); }
  .minus { color: var(--red); font-weight: var(--weight-medium); }
  .diff pre {
    margin: 0;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--border);
    font: 400 var(--text-xs)/1.65 var(--font-mono);
    overflow: hidden;
    white-space: pre;
  }
  .diff pre span { display: block; padding: 0 var(--space-3); }
  .hunk { color: var(--blue); }
  .del { background: var(--diff-del-bg); color: var(--red); }
  .add { background: var(--diff-add-bg); color: var(--green); }
  .perm { padding: var(--space-3); border-color: var(--amber); display: grid; gap: var(--space-3); }
  .perm-q { display: flex; align-items: center; gap: var(--space-2); font-weight: var(--weight-medium); }
  .perm-q :global(svg) { color: var(--amber); }
  .perm-cmd {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--sidebar);
    font-size: var(--text-xs);
  }
  .perm-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .pbtn {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: transform 140ms var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .pbtn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .pbtn.deny { color: var(--red); }
  .pbtn.pressed { transform: scale(0.95); box-shadow: 0 0 0 4px var(--accent-soft); }
  .accept { padding: var(--space-3) var(--space-3); display: grid; gap: var(--space-2); }
  .acc-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .acc-row > span:first-child { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--text-muted); }
  .acc-done { display: flex; align-items: center; gap: var(--space-2); color: var(--green); font-size: var(--text-sm); }
  [data-type] :global(.w) { transition: opacity var(--duration-fast); }
  [data-type] :global(.w.off) { opacity: 0; }

  .caption {
    display: block;
    width: min(560px, calc(100% - 24px));
    min-height: 38px;
    margin: var(--space-4) auto 0;
    text-align: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text);
  }
  .caption span { display: inline-block; transition: opacity 250ms, transform 250ms; }
  /* Shown when a pass ends, or from the start with reduced motion, where nothing plays on its own. */
