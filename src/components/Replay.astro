---
import Kite from './Kite.astro';
import Icon from './Icon.astro';
// A replay of one thread, drawn with the app's own tokens and the preview project's data.
// Without JavaScript or with reduced motion it shows the finished thread as a still frame.
---
<figure class="replay" data-replay aria-label="Replay of one CrewKite thread moving from OpenAI to Anthropic, then a Local review and Accept to a branch">
  <div class="win">
    <div class="win-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="win-title">Add netMinor(subtotalMinor, discountMinor) <em>demo-shop</em></span>
      <button class="rp-toggle" type="button" data-replay-toggle aria-label="Pause replay" hidden>
        <span class="i-pause"><Icon name="pause" size={14} /></span>
        <span class="i-play"><Icon name="play" size={14} /></span>
      </button>
    </div>
    <div class="win-body">
      <aside class="rail" aria-hidden="true">
        <div class="rail-brand"><Kite size={16} /><b>CrewKite</b></div>
        <div class="rail-item"><Icon name="plus" size={14} /> New thread</div>
        <div class="rail-label">Projects</div>
        <div class="rail-proj">demo-shop</div>
        <div class="rail-thread"><span class="dot" data-run></span>Add netMinor(subtotal…</div>
        <div class="rail-gauges">
          <div class="g" data-gauge="openai" style="--v:0">
            <div class="g-row"><span class="fam fam-o">O</span>OpenAI<span class="g-val"><span data-gauge-text>0</span>% left</span></div>
            <div class="g-bar"><i></i></div>
            <div class="g-sub">resets in 1 h 40 min</div>
          </div>
          <div class="g" style="--v:30">
            <div class="g-row"><span class="fam fam-a">A</span>Anthropic<span class="g-val">30% left</span></div>
            <div class="g-bar"><i></i></div>
            <div class="g-sub">resets in 2 h</div>
          </div>
          <div class="g g-local">
            <div class="g-row"><span class="fam fam-l">L</span>Local<span class="g-val">on this computer</span></div>
          </div>
        </div>
      </aside>

      <div class="thread" aria-hidden="true">
        <div class="thread-inner">
          <div class="it user" data-at="0">Add netMinor(subtotalMinor, discountMinor) to net.mjs. It must never return less than zero.</div>

          <div class="it turn" data-at="1">
            <div class="turn-h"><span class="fam fam-o">O</span>OpenAI · plan</div>
            <p data-type>The function is a stub. I will validate both inputs as safe integers, clamp the result at zero, then run the tests.</p>
          </div>

          <div class="it divider" data-at="3"><span>Continued on Anthropic from OpenAI. Reason: five-hour limit reached, resets in 1 h 40 min.</span></div>

          <div class="it turn" data-at="4">
            <div class="turn-h"><span class="fam fam-a">A</span>Anthropic · large-2</div>
            <div class="card tool"><span class="ti">◷</span>Thinking <span class="muted">Amounts are minor units, so safe integers only.</span></div>
            <div class="card tool"><span class="ti">▤</span><code>Read net.mjs</code><span class="ok"><Icon name="check" size={14} /></span></div>
          </div>

          <div class="it" data-at="5">
            <p data-type>netMinor is a stub today. I am replacing it with a version that checks both inputs are non-negative safe integers and returns the subtotal minus the discount, never below zero.</p>
          </div>

          <div class="it card diff" data-at="6">
            <div class="diff-h"><code>Edit net.mjs</code><span class="ok"><Icon name="check" size={14} /></span></div>
            <pre><span class="hunk">@@ -1,3 +1,6 @@</span><span class="del">-export function netMinor() &#123;</span><span class="del">-  throw new Error('netMinor is not implemented.');</span><span class="add">+export function netMinor(subtotalMinor, discountMinor) &#123;</span><span class="add">+  if (![subtotalMinor, discountMinor].every((v) =&gt; Number.isSafeInteger(v) &amp;&amp; v &gt;= 0)) &#123;</span><span class="add">+    throw new RangeError('Amounts must be non-negative safe integers.');</span><span class="add">+  &#125;</span><span class="add">+  return Math.max(0, subtotalMinor - discountMinor);</span><span> &#125;</span></pre>
            <div class="diff-f"><code>net.mjs <b class="plus">+5</b> <b class="minus">-2</b></code><span class="link">Open in Changes</span></div>
          </div>

          <div class="it card perm" data-at="7">
            <div class="perm-q"><Icon name="shield" size={16} />Run the tests in the scratch copy?</div>
            <code class="perm-cmd">node --test</code>
            <div class="perm-actions">
              <span class="pbtn primary" data-press="8">Allow once</span>
              <span class="pbtn">Allow for this thread</span>
              <span class="pbtn deny">Deny</span>
            </div>
          </div>

          <div class="it turn" data-at="9">
            <div class="turn-h"><span class="fam fam-l">L</span>Local · review</div>
            <p data-type>Tests pass in the scratch copy. The clamp holds when the discount equals or exceeds the subtotal. No changes needed.</p>
          </div>

          <div class="it card accept" data-at="10">
            <div class="acc-row">
              <span><Icon name="branch" size={15} /><code>add-netminor</code></span>
              <span class="pbtn primary" data-press="11">Accept to branch</span>
            </div>
            <div class="acc-done" data-at="11"><Icon name="check" size={14} />Committed on a new local branch. Your checkout is unchanged.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="caption" aria-live="off">
    <span data-caption>Accept makes a new local branch.</span>
  </figcaption>
</figure>

<style>
  .replay {
    margin: 0;
    position: relative;
  }
  .win {
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
    overflow: hidden;
    text-align: left;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 40px;
    padding: 0 12px 0 14px;
    border-bottom: 1px solid var(--border);
    background: var(--sidebar);
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .win-title {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win-title em {
    font-style: normal;
    color: var(--text-dim);
    margin-left: 6px;
  }
  .rp-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .rp-toggle .i-play { display: none; }
  .paused .rp-toggle .i-play { display: block; }
  .paused .rp-toggle .i-pause { display: none; }

  .win-body {
    display: grid;
    grid-template-columns: 210px 1fr;
    height: 540px;
  }
  .rail {
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .rail-brand {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .rail-item {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 5px 6px;
  }
  .rail-label {
    margin-top: 10px;
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 6px;
  }
  .rail-proj {
    padding: 4px 6px;
    color: var(--text);
  }
  .rail-thread {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px;
    border-radius: 7px;
    background: var(--surface-raised);
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-dim);
    flex: none;
  }
  .running .dot[data-run] {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
    animation: pulse 1.4s infinite;
  }
  @keyframes pulse {
    50% { box-shadow: 0 0 0 6px transparent; }
  }
  .rail-gauges {
    margin-top: auto;
    display: grid;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .g-row {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
  }
  .g-row .fam { width: 16px; height: 16px; font-size: 9px; }
  .g-val {
    margin-left: auto;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .g-bar {
    margin-top: 6px;
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .g-bar i {
    display: block;
    height: 100%;
    width: calc(var(--v) * 1%);
    border-radius: 2px;
    /* Green when full, yellow at 40 percent, red when empty, as the app colors it. */
    background: color-mix(in oklab, var(--green) calc(max(0, var(--v) - 40) * 1.666%), color-mix(in oklab, var(--amber) calc(min(var(--v), 40) * 2.5%), var(--red)));
    transition: width 900ms var(--ease);
  }
  .g-sub {
    margin-top: 4px;
    font-size: 11.5px;
    color: var(--text-dim);
  }

  .thread {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    mask-image: linear-gradient(to bottom, transparent 0, #000 70px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 70px);
  }
  .thread-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 28px 24px;
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.6;
  }
  .it,
  .acc-done {
    transition:
      opacity 420ms var(--ease),
      filter 420ms var(--ease);
  }
  /* With motion allowed, items start invisible from the first paint and only change opacity, so the
     replay never moves layout. The thread scrolls with a transform. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .thread { justify-content: flex-start; }
    :global(.js) .thread-inner { padding-top: 64px; transition: transform 600ms var(--ease); will-change: transform; }
    :global(.js) .it:not(.on),
    :global(.js) .acc-done:not(.on) { opacity: 0; filter: blur(2px); }
  }
  .user {
    align-self: flex-end;
    max-width: 78%;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    padding: 9px 13px;
    border-radius: 12px 12px 4px 12px;
  }
  .turn-h {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .turn-h .fam { width: 16px; height: 16px; font-size: 9px; }
  .turn {
    display: grid;
    gap: 8px;
  }
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12.5px;
    color: var(--text-muted);
    text-align: center;
  }
  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    min-width: 16px;
    height: 1px;
    background: linear-gradient(90deg, var(--openai), var(--anthropic));
    opacity: 0.6;
  }
  .card {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 9px;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
  }
  .ti {
    color: var(--text-dim);
    font-size: 13px;
  }
  .muted {
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ok {
    margin-left: auto;
    color: var(--green);
    display: inline-flex;
  }
  .diff-h,
  .diff-f {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    font-size: 13px;
  }
  .diff-f {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 12px;
  }
  .diff-f .link {
    margin-left: auto;
    color: var(--accent);
    font-size: 12px;
  }
  .plus { color: var(--green); font-weight: 500; }
  .minus { color: var(--red); font-weight: 500; }
  .diff pre {
    margin: 0;
    padding: 8px 0;
    border-top: 1px solid var(--border);
    font: 400 12px/1.65 var(--mono);
    overflow: hidden;
    white-space: pre;
  }
  .diff pre span {
    display: block;
    padding: 0 12px;
  }
  .hunk { color: var(--blue); }
  .del { background: var(--diff-del); color: var(--red); }
  .add { background: var(--diff-add); color: var(--green); }
  .perm {
    padding: 12px;
    border-color: var(--amber);
    display: grid;
    gap: 10px;
  }
  .perm-q {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }
  .perm-q :global(svg) { color: var(--amber); }
  .perm-cmd {
    display: block;
    padding: 8px 10px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--sidebar);
    font-size: 12.5px;
  }
  .perm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pbtn {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    font-size: 13px;
    font-weight: 500;
    transition: transform 140ms var(--ease), box-shadow 200ms var(--ease);
  }
  .pbtn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .pbtn.deny { color: var(--red); }
  .pbtn.pressed {
    transform: scale(0.95);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .accept {
    padding: 10px 12px;
    display: grid;
    gap: 8px;
  }
  .acc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .acc-row > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
  }
  .acc-done {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
    font-size: 13px;
  }
  [data-type] :global(.w) { transition: opacity 160ms; }
  [data-type] :global(.w.off) { opacity: 0; }

  .caption {
    position: absolute;
    left: 50%;
    bottom: -18px;
    transform: translateX(-50%);
    width: min(460px, calc(100% - 24px));
    text-align: center;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    box-shadow: 0 10px 30px -12px #0008;
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    max-width: calc(100% - 24px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .caption span {
    display: inline-block;
    transition: opacity 250ms, transform 250ms;
  }
  .caption span.swap {
    opacity: 0;
    transform: translateY(4px);
  }

  @media (max-width: 860px) {
    .win-body { grid-template-columns: 1fr; height: 500px; }
    .rail { display: none; }
    .thread-inner { padding: 16px 14px 20px; font-size: 13.5px; }
    .diff pre { font-size: 11px; }
  }
  @media (max-width: 480px) {
    .win-body { height: 460px; }
    .caption { font-size: 12.5px; white-space: normal; }
    .perm-actions .pbtn:nth-child(2) { display: none; }
  }
</style>
