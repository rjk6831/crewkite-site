---
// The default is the macOS build. The Worker rewrites this button from the request's user agent:
// Linux gets the preview, Windows gets a plain line with no button. No client script is involved.
// Until the release is published the button is disabled and says so; the Worker leaves it alone.
import Icon from './Icon.astro';
import { ASSETS, url } from '../data/site.js';
import { RELEASE, UNRELEASED_LABEL } from '../data/release.js';
interface Props { variant?: 'hero' | 'final' }
const { variant = 'hero' } = Astro.props;
---
{RELEASE.published ? (
  <a class="btn btn-primary dl" data-dl={variant} href={url(ASSETS.mac)}>
    <Icon name="download" /><span data-dl-label>Download for macOS</span>
  </a>
) : (
  <button class="btn btn-primary dl" type="button" disabled>
    <Icon name="download" /><span>{UNRELEASED_LABEL}</span>
  </button>
)}
<style>
  .dl { min-width: 220px; }
  :global(.dl-note) {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-strong);
    color: var(--text-muted);
    font-size: var(--text-md);
  }
</style>
