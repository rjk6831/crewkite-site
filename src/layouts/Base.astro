---
import '../styles/tokens.css';
import '../styles/global.css';
import Kite from '../components/Kite.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import { REPO, BLOB, VERSION_FALLBACK, ONE_LINER } from '../data/site.js';

interface Props { title: string; description?: string; path?: string }
const { title, description = ONE_LINER, path = '/' } = Astro.props;
const canonical = new URL(path, 'https://crewkite.dev').href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CrewKite',
  description: ONE_LINER,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  softwareVersion: VERSION_FALLBACK,
  license: 'Apache-2.0',
  url: 'https://crewkite.dev',
  downloadUrl: 'https://crewkite.dev/download',
  codeRepository: REPO,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Raymond J. Kraft' },
  publisher: { '@type': 'Organization', name: 'Roots No Limits LLC' },
};
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#151718" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jbmono.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CrewKite" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://crewkite.dev/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://crewkite.dev/og.png" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');var t=null;try{t=localStorage.getItem('theme');}catch(e){}if(t!=='light'&&t!=='dark'){try{t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';}catch(e){t='dark';}}d.dataset.theme=t;var q=/[?&]intro=1(&|$)/.test(location.search),s=null;try{s=sessionStorage.getItem('kite');}catch(e){}if((q||!s)&&!matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('kite-intro');try{sessionStorage.setItem('kite','1');}catch(e){}}})();</script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top" id="top">
    <div class="wrap top-row">
      <a class="brand" href="/" aria-label="CrewKite home">
        <span class="wordmark wordmark-base" aria-hidden="true">
          <span class="kite-x"><span class="kite-glow"></span><span class="kite-y"><Kite size={20} /></span><span class="kite-string"></span></span>
        </span>
      </a>
      <nav aria-label="Main">
        <a href="/download" class="nav-link" aria-current={here === '/download' ? 'page' : undefined}>Download</a>
        <a href="/safety" class="nav-link" aria-current={here === '/safety' ? 'page' : undefined}>Safety</a>
        <a href={REPO} class="nav-link nav-gh" aria-label="CrewKite on GitHub">
          <Icon name="code" size={16} />
          <span>GitHub</span>
        </a>
        <button class="theme" type="button" aria-label="Switch to light theme" title="Switch to light theme">
          <span class="t-sun"><Icon name="sun" size={17} /></span>
          <span class="t-moon"><Icon name="moon" size={17} /></span>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <a class="brand brand-foot" href="/" aria-label="CrewKite home"><span class="wordmark wordmark-full" aria-hidden="true"></span></a>
        <p class="foot-note">CrewKite by Roots No Limits LLC, created by Raymond J. Kraft, <Email /></p>
        <p class="foot-note">This site sets no cookies and counts page views without identifying you.</p>
      </div>
      <div>
        <h2 class="foot-h">Product</h2>
        <ul>
          <li><a href="/download">Download</a></li>
          <li><a href="/safety">Safety</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/changelog">Changelog</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-h">Project</h2>
        <ul>
          <li><a href={REPO}>Source on GitHub</a></li>
          <li><a href="/docs">Docs</a></li>
          <li><a href={`${BLOB}/SECURITY.md`}>Report a security issue</a></li>
          <li><a href={`${BLOB}/LICENSE`}>Apache License 2.0</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-h">Domains</h2>
        <ul>
          <li><a href="https://crewkite.dev">crewkite.dev</a></li>
          <li><a href="https://crewkite.app">crewkite.app</a></li>
        </ul>
      </div>
    </div>
  </footer>
  <script src="/site.js" defer></script>
</body>
</html>

<style is:global>
  .top {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* Near-solid, so nothing behind it is legible at any scroll position, with a hairline under it. */
    background: color-mix(in srgb, var(--background) 94%, transparent);
    backdrop-filter: saturate(150%) blur(16px);
    -webkit-backdrop-filter: saturate(150%) blur(16px);
    border-bottom: var(--border-hairline) solid var(--border);
  }
  .top.scrolled {
    border-bottom-color: var(--border);
  }
  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
  }

  /* The wordmark is a background image per theme, so only the active theme's file loads and the
     theme switch never flashes. The header copy has its kite cut out; the kite is an SVG layer drawn
     in the wordmark's own coordinates and placed over the gap, so it can fly in on its own. */
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    text-decoration: none;
    flex: none;
  }
  .wordmark {
    position: relative;
    display: block;
    height: var(--wordmark-height);
    aspect-ratio: 998 / 322;
    background: no-repeat center / contain;
  }
  .wordmark-base { background-image: image-set(url('/img/brand/wordmark-base-dark-1x.webp') 1x, url('/img/brand/wordmark-base-dark-2x.webp') 2x); }
  .wordmark-full { background-image: image-set(url('/img/brand/wordmark-full-dark-1x.webp') 1x, url('/img/brand/wordmark-full-dark-2x.webp') 2x); }
  :root[data-theme='light'] .wordmark-base { background-image: image-set(url('/img/brand/wordmark-base-light-1x.webp') 1x, url('/img/brand/wordmark-base-light-2x.webp') 2x); }
  :root[data-theme='light'] .wordmark-full { background-image: image-set(url('/img/brand/wordmark-full-light-1x.webp') 1x, url('/img/brand/wordmark-full-light-2x.webp') 2x); }
  .brand-foot .wordmark { height: var(--wordmark-height-small); }

  /* Kite entrance, once per visit. The head script sets .kite-intro before first paint; site.js
     flies the kite layer with transform and opacity only, 300 ms after first paint. Its box sits
     inside the wordmark, so the header never shifts. If the script never runs, the kite fades in
     where it belongs. */
  /* The kite is drawn larger than its slot in the raster, by --kite-mark-scale, so it reads as a
     mark beside the word. It grows from its anchor, the point where the string meets the kite
     (34% across, at the bottom of its box), so it stays on the wordmark baseline and keeps the same
     ratio to the word at every breakpoint. */
  .kite-x {
    --kx: calc(85.57% + 0.34 * 14.03%);
    --ky: calc(0.93% + 52.8%);
    position: absolute;
    left: calc(var(--kx) - 0.34 * 14.03% * var(--kite-mark-scale));
    top: calc(var(--ky) - 52.8% * var(--kite-mark-scale));
    width: calc(14.03% * var(--kite-mark-scale));
    height: calc(52.8% * var(--kite-mark-scale));
  }
  .kite-y,
  .kite-x .kite {
    display: block;
    width: 100%;
    height: 100%;
  }
  .kite-glow,
  .kite-string {
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }
  .kite-glow {
    inset: calc(-1 * var(--space-3));
    border-radius: var(--radius-full);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 55%, transparent) 0, transparent 68%);
  }
  .kite-string {
    left: 32%;
    top: 96%;
    width: 1px;
    height: 18px;
    background: linear-gradient(var(--text-dim), transparent);
    transform-origin: 50% 0;
  }
  .kite-intro .top .kite-x {
    opacity: 0;
    animation: kite-fallback var(--duration-moderate) ease-out 2000ms forwards;
  }
  @keyframes kite-fallback {
    to { opacity: 1; }
  }

  .top nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .nav-link,
  .theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 40px;
    height: 40px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    border: 0;
    background: transparent;
    font: var(--weight-medium) var(--text-ui) / 1 var(--font-sans);
    color: var(--text-muted);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--duration-fast), background var(--duration-fast);
  }
  .theme { padding: 0; width: 40px; }
  .nav-link:hover,
  .theme:hover {
    color: var(--text);
    background: var(--surface);
  }
  .nav-link[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }
  /* The toggle's cue, once, when the kite lands: one turn of the icon and a soft accent ring that
     fades. Transform, opacity and shadow only, and nothing under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .theme.cue { animation: theme-ring 700ms var(--ease-out) 1; }
    .theme.cue svg { animation: theme-turn 360ms var(--ease-out) 1; }
  }
  @keyframes theme-turn {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes theme-ring {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent); }
    35% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 28%, transparent); }
    100% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--accent) 0%, transparent); }
  }
  .t-sun { display: none; }
  :root[data-theme='light'] .t-sun { display: block; }
  :root[data-theme='light'] .t-moon { display: none; }
  @media (max-width: 767px) {
    .nav-gh span { display: none; }
    .nav-link { padding: 0 var(--space-2); }
  }

  .foot {
    border-top: 1px solid var(--border);
    padding: var(--space-16) 0 var(--space-16);
    margin-top: var(--space-8);
    font-size: var(--text-md);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
  }
  .foot-note {
    margin-top: var(--space-3);
    color: var(--text-muted);
    max-width: 40ch;
  }
  .foot-h {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: var(--space-3);
  }
  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .foot ul a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .foot ul a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 767px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-brand { grid-column: 1 / -1; }
  }
</style>
